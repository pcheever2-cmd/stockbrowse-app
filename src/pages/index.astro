                <div class="px-3 py-1 rounded-full text-xs font-semibold bg-[#0C0F14] text-[#94A3B8]" title="Needs ~30 days of trading and a few quarters of filings before it can be Compass-scored">Score pending</div>
              </div>
              <div class="space-y-1 text-xs text-[#CBD5E1]">
                <div>${stock.normalizedIndustry}</div>
                <div>Market Cap: ${formatMarketCap(stock.marketCap)}</div>
                <div class="text-[#64748B]">IPO'd ${stock.ipoDate}${days ? ` · ${days}` : ''}</div>
              </div>
            </div>
          `;
        }
        const gradeColors = {
          'A': 'bg-emerald-100 text-emerald-700',
          'B': 'bg-blue-100 text-blue-700',
          'C': 'bg-[#0C0F14] text-slate-700',
          'D': 'bg-amber-100 text-amber-700',
          'F': 'bg-red-100 text-red-700'
        };
        const isInWatchlist = watchlist.includes(stock.symbol);
        const heartIcon = isInWatchlist
          ? '<svg class="w-5 h-5 fill-current text-red-500" viewBox="0 0 24 24"><path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/></svg>'
          : '<svg class="w-5 h-5 stroke-current" fill="none" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/></svg>';

        // Golden flag (premium, hydrated into goldenSet at runtime)
        const isGolden = goldenSet.has(stock.symbol);

        const cardBorder = isGolden
          ? 'border-2 border-amber-400 shadow-[0_0_15px_rgba(251,191,36,0.3)]'
          : 'border border-[rgba(255,255,255,0.06)]';

        const goldenBadge = isGolden
          ? '<div class="absolute -top-2 -right-2 bg-gradient-to-r from-amber-400 to-yellow-500 text-black text-xs font-bold px-2 py-0.5 rounded-full shadow-lg">⭐ GOLDEN</div>'
          : '';

        // Curated "why this matches the theme" line — only present on catalog hits.
        const whyEntry = semanticWhy.get(stock.symbol);
        const isPicksShovels = whyEntry && whyEntry.kind === 'picks-shovels';
        const kindLabel = isPicksShovels ? 'Picks &amp; shovels' : 'Direct';
        const kindTitle = isPicksShovels
          ? 'Supplies the theme without being a pure play on it'
          : 'A direct bet on the theme';
        const whyLine = whyEntry
          ? `<div class="mb-3 text-xs text-[#94A3B8] flex items-start gap-1.5">
               <span class="shrink-0 mt-0.5 px-1.5 py-0.5 rounded text-[10px] font-semibold ${isPicksShovels ? 'bg-sky-500/15 text-sky-300' : 'bg-emerald-500/15 text-emerald-300'}" title="${kindTitle}">${kindLabel}</span>
               <span>${escapeHtml(whyEntry.why)}</span>
             </div>`
          : '';

        return `
          <div class="relative bg-[#161B24] ${cardBorder} rounded-xl p-4 hover:shadow-lg transition">
            ${goldenBadge}
            <div class="flex justify-between items-start mb-3">
              <a href="/stock/${stock.symbol.toLowerCase()}" class="flex-1">
                <h3 class="font-bold text-lg">${stock.symbol}</h3>
                <p class="text-[#64748B] text-sm truncate">${stock.name}</p>
              </a>
              <button onclick="toggleWatchlist('${stock.symbol}')" class="p-2 hover:bg-[#0C0F14] rounded-lg transition">
                ${heartIcon}
              </button>
            </div>

            <div class="flex items-center justify-between mb-3">
              <div class="text-2xl font-bold">$${stock.price.toFixed(2)}</div>
              <div class="flex items-center gap-2">
                <div class="${gradeColors[stock.grade]} px-3 py-1 rounded-full text-sm font-bold" title="Compass Score">
                  ${stock.compassScore}
                </div>
                ${catalystTagSet.has(stock.symbol) ? `<div class="bg-[#22D3EE]/20 text-[#22D3EE] px-2 py-1 rounded-full text-xs font-bold catalyst-badge" data-symbol="${stock.symbol}" title="Catalyst — recent earnings beats + analyst upgrades">⚡</div>` : ''}
              </div>
            </div>

            ${whyLine}

            <div class="space-y-1 text-xs text-[#CBD5E1] mb-3">
              <div>${stock.normalizedIndustry}</div>
              <div>Market Cap: ${formatMarketCap(stock.marketCap)}</div>
            </div>

            <a href="/stock/${stock.symbol.toLowerCase()}"
               class="block w-full bg-[#22D3EE] hover:bg-[#06B6D4] text-white text-center py-2 rounded-lg font-semibold transition">
              View Details
            </a>
          </div>
        `;
      }).join('');

      // Premium: replace the ⚡ placeholder with the catalyst number on each card (if hydrated).
      hydrateCatalystBadges();
    }

    // Fill .catalyst-badge with the numeric catalyst score for premium users (⚡ + score);
    // no-op for free users (badge stays "⚡"). Re-run after every render.
    function hydrateCatalystBadges() {
      const map = window.__catalystMap || {};
      document.querySelectorAll('.catalyst-badge').forEach(badge => {
        const sym = badge.dataset.symbol;
        if (sym && map[sym] != null) {
          badge.textContent = `⚡${map[sym]}`;
        }
      });
    }

    function updateActiveFilters() {
      const container = document.getElementById('activeFilters');
      const chips = [];

      if (filters.search) chips.push({ type: 'search', value: filters.search, label: `"${filters.search}"` });
      filters.grades.forEach(g => chips.push({ type: 'grades', value: g, label: `Grade ${g}` }));
      filters.industries.forEach(i => chips.push({ type: 'industries', value: i, label: i }));
      filters.priceRanges.forEach(r => {
        const [min, max] = r.split('-').map(Number);
        const label = max > 500 ? `$${min}+` : `$${min}-$${max}`;
        chips.push({ type: 'priceRanges', value: r, label });
      });
      filters.marketCapRanges.forEach(r => {
        const [min, max] = r.split('-').map(Number);
        let label = '';
        if (max > 200) label = 'Mega Cap';
        else if (min >= 10) label = 'Large Cap';
        else if (min >= 2) label = 'Mid Cap';
        else label = 'Small Cap';
        chips.push({ type: 'marketCapRanges', value: r, label });
      });
      filters.valuationRatings.forEach(v => chips.push({ type: 'valuationRatings', value: v, label: v }));
      if (filters.goldenOnly) chips.push({ type: 'goldenOnly', value: 'true', label: '⭐ Golden Only' });
      if (filters.catalystOnly) chips.push({ type: 'catalystOnly', value: 'true', label: '⚡ Catalyst Only' });

      // Update mobile filter count badge
      const mobileCount = document.getElementById('mobileFilterCount');
      if (mobileCount) {
        if (chips.length > 0) {
          mobileCount.textContent = chips.length;
          mobileCount.classList.remove('hidden');
        } else {
          mobileCount.classList.add('hidden');
        }
      }

      if (chips.length === 0) {
        container.classList.add('hidden');
        return;
      }

      container.classList.remove('hidden');
      container.innerHTML = chips.map(chip => `
        <button class="flex items-center gap-1 bg-[#22D3EE]/20 text-[#22D3EE] px-3 py-1 rounded-full text-sm"
                onclick="removeFilter('${chip.type}', '${chip.value}')">
          ${chip.label}
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
          </svg>
        </button>
      `).join('');
    }

    function removeFilter(type, value) {
      if (type === 'search') {
        filters.search = '';
        document.getElementById('searchInput').value = '';
      } else if (type === 'goldenOnly') {
        filters.goldenOnly = false;
        const gf = document.getElementById('goldenFilter');
        gf?.classList.remove('opacity-100', 'border-amber-400');
        gf?.classList.add('opacity-60');
      } else if (type === 'catalystOnly') {
        filters.catalystOnly = false;
        const cf = document.getElementById('catalystFilter');
        cf?.classList.remove('opacity-100', 'border-[#22D3EE]');
        cf?.classList.add('opacity-60');
      } else if (type === 'valuationRatings') {
        filters.valuationRatings = filters.valuationRatings.filter(v => v !== value);
        const checkbox = document.querySelector(`input[name="valuation"][value="${value}"]`);
        if (checkbox) checkbox.checked = false;
      } else {
        filters[type] = filters[type].filter(v => v !== value);
        // Uncheck the corresponding checkbox
        const checkbox = document.querySelector(`input[name="${type.replace(/Ranges$/, '').replace(/s$/, '')}"][value="${value}"]`);
        if (checkbox) checkbox.checked = false;
      }
      applyFilters();
    }

    function clearAllFilters() {
      // Invalidate any in-flight semantic/probe response and drop semantic
      // state — a slow "oil" reply must not repaint a basket over the
      // just-cleared grid.
      ++searchSeq;
      semanticRank = null;
      semanticWhy = new Map();
      document.getElementById('smartSearchHint')?.classList.add('hidden');
      filters = {
        search: '',
        grades: [],
        industries: [],
        priceRanges: [],
        marketCapRanges: [],
        valuationRatings: [],
        goldenOnly: false,
        catalystOnly: false,
        sort: filters.sort === 'relevance-desc' ? 'score-desc' : filters.sort
      };
      const clearSortSelect = document.getElementById('sortSelect');
      if (clearSortSelect && clearSortSelect.value === 'relevance-desc') clearSortSelect.value = 'score-desc';
      document.getElementById('searchInput').value = '';
      document.querySelectorAll('.filter-checkbox').forEach(cb => cb.checked = false);
      document.querySelectorAll('.grade-chip').forEach(c => { c.classList.remove('opacity-100', 'border-[#22D3EE]'); c.classList.add('opacity-60'); });
      document.getElementById('goldenFilter')?.classList.remove('opacity-100', 'border-amber-400');
      document.getElementById('goldenFilter')?.classList.add('opacity-60');
      document.getElementById('catalystFilter')?.classList.remove('opacity-100', 'border-[#22D3EE]');
      document.getElementById('catalystFilter')?.classList.add('opacity-60');
      applyFilters();
    }

    // Make functions global for onclick handlers
    window.toggleWatchlist = toggleWatchlist;
    window.removeFilter = removeFilter;
    window.formatMarketCap = (marketCap) => {
      if (!marketCap || marketCap <= 0) return 'N/A';
      if (marketCap >= 1000) return `$${(marketCap / 1000).toFixed(1)}T`;
      if (marketCap >= 1) return `$${marketCap.toFixed(1)}B`;
      return `$${(marketCap * 1000).toFixed(0)}M`;
    };

    // Escape text injected into card innerHTML (curated "why" lines, etc.)
    function escapeHtml(str) {
      return String(str ?? '').replace(/[&<>"']/g, (c) =>
        ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
    }

    // Search suggestions
    const searchExamples = [
      { query: 'stocks like Amazon', description: 'Find similar companies by industry & size' },
      { query: 'best tech stocks', description: 'Top-rated technology companies' },
      { query: 'cheap dividend stocks', description: 'Affordable income-generating stocks' },
      { query: 'under $50', description: 'Stocks priced below $50' },
      { query: 'high quality healthcare', description: 'A-rated healthcare stocks' },
      { query: 'safe large cap', description: 'Low-risk established companies' },
      { query: 'growth stocks', description: 'Technology & healthcare growth plays' }
    ];

    function showSearchSuggestions(query) {
      const suggestions = document.getElementById('searchSuggestions');

      if (!query || query.length < 2) {
        suggestions.classList.add('hidden');
        return;
      }

      // Show relevant examples
      const matches = searchExamples.filter(ex =>
        ex.query.toLowerCase().includes(query.toLowerCase()) ||
        ex.description.toLowerCase().includes(query.toLowerCase())
      );

      if (matches.length === 0) {
        suggestions.classList.add('hidden');
        return;
      }

      suggestions.innerHTML = matches.map(ex => `
        <button class="w-full text-left px-4 py-3 hover:bg-[#080A0F] border-b border-[rgba(255,255,255,0.06)] last:border-b-0"
                onclick="document.getElementById('searchInput').value = '${ex.query}'; document.getElementById('searchInput').dispatchEvent(new Event('input')); document.getElementById('searchSuggestions').classList.add('hidden');">
          <div class="font-semibold text-sm text-slate-100">${ex.query}</div>
          <div class="text-xs text-[#64748B]">${ex.description}</div>
        </button>
      `).join('');

      suggestions.classList.remove('hidden');
    }

    // Event listeners
    let searchTimeout;
    document.getElementById('searchInput').addEventListener('input', (e) => {
      const query = e.target.value;
      filters.search = query;

      // Show suggestions
      showSearchSuggestions(query);

      // Clear previous timeout
      clearTimeout(searchTimeout);

      // Debounce for smart search parsing
      searchTimeout = setTimeout(async () => {
        const hintEl = document.getElementById('smartSearchHint');
        const hintText = document.getElementById('smartSearchText');
        const sortSelect = document.getElementById('sortSelect');
        const q = query.trim();
        const ql = q.toLowerCase();

        // Single tokens that match a ticker or a company-name PREFIX are
        // lookup-SHAPED — but "oil" (starts "Oil-Dri"), "gold" (Barrick's
        // ticker), and "tide" (starts "Tidewater") usually mean the THEME.
        // These go out as catalog PROBES (catalogOnly): literal matches
        // render immediately below, and the grid upgrades to curated picks
        // + why-lines only if the catalog covers the word. A probe miss
        // costs no search quota and logs no miss, so plain lookups like
        // "apple" or "netfl" stay free. Brand words ("xbox") that match no
        // name go full semantic: MSFT pins via the alias AND the ecosystem
        // basket (EA, Take-Two...) comes back from the catalog.
        const singleToken = q.length >= 2 && !q.includes(' ');
        const catalogProbe = singleToken &&
          (SYMBOL_SET.has(ql) ||
           allStocks.some(s => s.name.toLowerCase().startsWith(ql)) ||
           recentIpos.some(s => s.symbol.toLowerCase() === ql || s.name.toLowerCase().startsWith(ql)));
        // Require >=2 chars (2-char themes like "vr"/"ar" exist) so single-keystroke fragments
        // don't fire an embedding + Vectorize call + miss-log; the longer debounce below does the rest.
        const goSemantic = q.length >= 2;
        // Guard against out-of-order responses: a slow "oi" reply must not
        // clobber the "oil" basket that already rendered.
        const seq = ++searchSeq;

        if (goSemantic) {
          const parsed = parseSmartSearch(query);

          // For thematic queries, honor explicit numeric/grade words ("cheap", "under $50",
          // "safe"). For "stocks like X" skip these (they're derived from the reference
          // stock). Probes skip them too: "solid"/"top"/"penny" are company lookups first —
          // mutating grade/price filters would hide the very stock being looked up.
          if (!parsed.similarTo && !catalogProbe) {
            if (parsed.grades.length > 0) filters.grades = [...new Set(parsed.grades)];
            if (parsed.priceRanges.length > 0) filters.priceRanges = [...new Set(parsed.priceRanges)];
            if (parsed.marketCapRanges && parsed.marketCapRanges.length > 0) filters.marketCapRanges = [...new Set(parsed.marketCapRanges)];
          }

          if (catalogProbe) {
            // Literal-first: show ticker/name matches NOW (a lookup must not
            // wait on the network); the probe upgrades the grid on a hit.
            semanticRank = null;
            semanticWhy = new Map();
            if (filters.sort === 'relevance-desc') {
              filters.sort = 'score-desc';
              if (sortSelect) sortSelect.value = 'score-desc';
            }
            hintEl.classList.add('hidden');
            applyFilters();
          } else {
            hintText.textContent = 'Searching…';
            hintEl.classList.remove('hidden');
          }

          const result = await fetchSemanticResults(query, parsed.similarTo, catalogProbe);
          if (seq !== searchSeq) return; // superseded by a newer query
          semanticRank = result ? result.rank : null;
          semanticWhy = result ? result.why : new Map();

          if (semanticRank) {
            filters.sort = 'relevance-desc';
            if (sortSelect) sortSelect.value = 'relevance-desc';
            hintText.textContent = parsed.similarTo
              ? `Stocks similar to ${parsed.similarTo.name}`
              : `Best matches for "${q}"`;
            hintEl.classList.remove('hidden');
          } else {
            // Miss / probe miss / error: stay literal — and restore the
            // default sort if a PREVIOUS semantic query set relevance, or
            // sortStocks() is left comparing a field it doesn't know.
            if (filters.sort === 'relevance-desc') {
              filters.sort = 'score-desc';
              if (sortSelect) sortSelect.value = 'score-desc';
            }
            hintEl.classList.add('hidden');
          }
        } else {
          // Lookup fragment or cleared: drop semantic mode, restore default sort.
          semanticRank = null;
          semanticWhy = new Map();
          if (filters.sort === 'relevance-desc') {
            filters.sort = 'score-desc';
            if (sortSelect) sortSelect.value = 'score-desc';
          }
          hintEl.classList.add('hidden');
        }

        applyFilters();

        setTimeout(() => {
          document.getElementById('searchSuggestions')?.classList.add('hidden');
        }, 100);
      }, 600); // Wait 600ms after typing stops — collapses mid-word keystrokes so partials don't embed/log
    });

    // Hide suggestions when clicking outside
    document.addEventListener('click', (e) => {
      const searchInput = document.getElementById('searchInput');
      const suggestions = document.getElementById('searchSuggestions');
      if (e.target !== searchInput && !suggestions?.contains(e.target)) {
        suggestions?.classList.add('hidden');
      }
    });

    document.getElementById('sortSelect').addEventListener('change', (e) => {
      filters.sort = e.target.value;
      applyFilters();
    });

    // Grade checkboxes removed — now using grade chip toggles above

    document.querySelectorAll('input[name="industry"]').forEach(input => {
      input.addEventListener('change', (e) => {
        if (e.target.checked) {
          filters.industries.push(e.target.value);
        } else {
          filters.industries = filters.industries.filter(i => i !== e.target.value);
        }
        applyFilters();
      });
    });

    document.querySelectorAll('input[name="price"]').forEach(input => {
      input.addEventListener('change', (e) => {
        if (e.target.checked) {
          filters.priceRanges.push(e.target.value);
        } else {
          filters.priceRanges = filters.priceRanges.filter(p => p !== e.target.value);
        }
        applyFilters();
      });
    });

    document.querySelectorAll('input[name="marketcap"]').forEach(input => {
      input.addEventListener('change', (e) => {
        if (e.target.checked) {
          filters.marketCapRanges.push(e.target.value);
        } else {
          filters.marketCapRanges = filters.marketCapRanges.filter(m => m !== e.target.value);
        }
        applyFilters();
      });
    });

    // Grade chip toggles
    document.querySelectorAll('.grade-chip').forEach(chip => {
      chip.addEventListener('click', () => {
        const grade = chip.dataset.gradeChip;
        if (filters.grades.includes(grade)) {
          filters.grades = filters.grades.filter(g => g !== grade);
          chip.classList.remove('opacity-100', 'border-[#22D3EE]');
          chip.classList.add('opacity-60');
        } else {
          filters.grades.push(grade);
          chip.classList.add('opacity-100', 'border-[#22D3EE]');
          chip.classList.remove('opacity-60');
        }
        applyFilters();
      });
    });

    // Golden toggle button
    document.getElementById('goldenFilter').addEventListener('click', () => {
      filters.goldenOnly = !filters.goldenOnly;
      const btn = document.getElementById('goldenFilter');
      if (filters.goldenOnly) {
        btn.classList.add('opacity-100', 'border-amber-400');
        btn.classList.remove('opacity-60');
      } else {
        btn.classList.remove('opacity-100', 'border-amber-400');
        btn.classList.add('opacity-60');
      }
      applyFilters();
    });

    // Catalyst toggle button — shows for everyone, but only FUNCTIONS for premium.
    document.getElementById('catalystFilter').addEventListener('click', () => {
      if (!window.__catalystAccess) { window.showUpgradeModal?.(); return; }
      filters.catalystOnly = !filters.catalystOnly;
      const btn = document.getElementById('catalystFilter');
      if (filters.catalystOnly) {
        btn.classList.add('opacity-100', 'border-[#22D3EE]');
        btn.classList.remove('opacity-60');
      } else {
        btn.classList.remove('opacity-100', 'border-[#22D3EE]');
        btn.classList.add('opacity-60');
      }
      applyFilters();
    });

    // Dropdown popover toggle
    document.querySelectorAll('.filter-dropdown-btn').forEach(btn => {
      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        const popover = btn.nextElementSibling;
        // Close all other popovers first
        document.querySelectorAll('.filter-popover').forEach(p => {
          if (p !== popover) p.classList.add('hidden');
        });
        popover?.classList.toggle('hidden');
      });
    });

    // Close popovers when clicking outside
    document.addEventListener('click', () => {
      document.querySelectorAll('.filter-popover').forEach(p => p.classList.add('hidden'));
    });
    // Prevent popover clicks from closing themselves
    document.querySelectorAll('.filter-popover').forEach(p => {
      p.addEventListener('click', (e) => e.stopPropagation());
    });

    // Valuation filter (premium — requires runtime data fetch)
    document.querySelectorAll('input[name="valuation"]').forEach(input => {
      input.addEventListener('change', (e) => {
        if (e.target.checked) {
          filters.valuationRatings.push(e.target.value);
        } else {
          filters.valuationRatings = filters.valuationRatings.filter(v => v !== e.target.value);
        }
        applyFilters();
      });
    });

    // Expose globals for the premium valuation module script
    window.__valuationMap = valuationMap;
    window.__allStockSymbols = allStocks.map(s => s.symbol);
    window.__applyFilters = applyFilters;
    window.__browseFilters = filters;
    // Golden set + catalyst tag-set/score-map are hydrated by the premium module script below.
    window.__goldenSet = goldenSet;
    window.__catalystTagSet = catalystTagSet;
    window.__catalystMap = {};
    window.__catalystAccess = false;

    document.getElementById('clearFilters').addEventListener('click', clearAllFilters);
    document.getElementById('clearFiltersBtn')?.addEventListener('click', clearAllFilters);

    // Initial render - restore filters from URL first (for back button support)
    updateWatchlistBadge();
    restoreFiltersFromURL();
    applyFilters();
  </script>

  <!-- Premium valuation filter — separate module script so Astro bundles the imports -->
  <script>
    import { loadSession, hasFeature } from '../lib/subscription';
    import { authFetch } from '../lib/authFetch';

    // Expose to the classic inline script (which can't import modules) so the
    // semantic-search fetch sends the Bearer — paid users are exempt from the
    // free search quota server-side.
    (window as any).__authFetch = authFetch;

    // Wire the valuation-filter section to the upgrade modal for users without Pro.
    function wireValuationUpsell() {
      const section = document.getElementById('valuationFilterSection');
      if (!section) return;
      section.addEventListener('click', (e: Event) => {
        if ((e.target as HTMLElement).closest('input')) {
          e.preventDefault();
          (window as any).showUpgradeModal?.();
        }
      });
    }

    async function loadPremiumFilters() {
      await loadSession();

      // Golden + Catalyst are PLUS features (the premium API itself only requires 'plus');
      // the Valuation filter is PRO-only. Gate each on its OWN feature so Plus users get
      // Golden/Catalyst — previously the whole block sat behind valuation_score (Pro), so
      // Plus users saw zero Golden and zero Catalyst.
      const isPremium = hasFeature('golden_stocks');      // Plus and Pro
      const hasValuation = hasFeature('fair_value');       // Pro only (fundamental Fair Value)

      // Valuation filter UI: enable for Pro; otherwise wire the upsell (incl. Plus users).
      if (hasValuation) {
        const filtersEl = document.getElementById('valuationFilters');
        const badge = document.getElementById('valuationPremiumBadge');
        if (filtersEl) filtersEl.classList.remove('opacity-50', 'pointer-events-none');
        if (badge) badge.remove();
      } else {
        wireValuationUpsell();
      }

      // Free / newsletter: no premium per-stock data; the Catalyst chip stays locked.
      if (!isPremium) return;

      // Plus+ → unlock the Catalyst (and Golden) filters and hydrate the sets.
      (window as any).__catalystAccess = true;

      const valuationMap: Record<string, string> = (window as any).__valuationMap || {};
      const goldenSet: Set<string> = (window as any).__goldenSet || new Set();
      const catalystTagSet: Set<string> = (window as any).__catalystTagSet || new Set();
      const catalystMap: Record<string, number> = (window as any).__catalystMap || {};

      try {
        // ONE request for the whole-universe premium-filter map (Catalyst/Golden/Valuation),
        // served from a single KV key. Replaces ~85 per-symbol round-trips, so the filters
        // hydrate near-instantly instead of trickling in (which showed a partial count if the
        // filter was toggled before it finished).
        const res = await authFetch('/api/stocks/premium-summary');
        if (res.ok) {
          const data = await res.json();
          Object.entries(data).forEach(([sym, fields]: [string, any]) => {
            if (hasValuation && fields?.fairValueVerdict) valuationMap[sym] = fields.fairValueVerdict;
            if (fields?.isGolden) goldenSet.add(sym);
            if (fields?.catalystTag) catalystTagSet.add(sym);
            if (fields?.catalystScore != null) catalystMap[sym] = fields.catalystScore;
          });
        }
      } finally {
        // Always re-render with whatever hydrated, so Golden borders + catalyst chips/numbers
        // appear and any Golden/valuation/catalyst filters restored from the URL re-apply.
        Object.assign((window as any).__valuationMap, valuationMap);
        Object.assign((window as any).__catalystMap, catalystMap);
        (window as any).__applyFilters?.();
      }
    }

    loadPremiumFilters();
  </script>
</Layout>
