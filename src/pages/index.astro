---
import Layout from '../layouts/Layout.astro';
import { stocks, getGradeColor, formatPrice, formatMarketCap, getNormalizedIndustry, displayIndustries } from '../data/stocks';
// Recently-IPO'd names that can't be Compass-scored yet (built by the data
// pipeline's collectors/collect_ipos.py). Surfaced in SEARCH ONLY, as "score
// pending" cards, so a lookup for e.g. SPCX / SpaceX returns the real company.
import recentIposRaw from '../data/recent-ipos.json';

// Pre-process all stocks for the page.
// IMPORTANT: only public fields are passed into the client-side define:vars.
// Premium fields (isGolden, valuationRating, factorValues, etc.) are fetched at
// runtime via /api/stocks/premium for paid users — never embedded in static HTML.
// The build canary at scripts/check-leakage.sh enforces this.
const allStocks = stocks.map(s => ({
  symbol: s.symbol,
  name: s.name,
  price: s.price,
  compassScore: s.compassScore,
  grade: s.grade,
  industry: s.industry,
  marketCap: s.marketCap,
  normalizedIndustry: getNormalizedIndustry(s.industry),
}));

// Score-pending IPOs for the search index (all public fields). Kept separate from
// allStocks so they never enter the ranked grid, sorts, or score/grade filters.
const recentIpos = (recentIposRaw || []).map(s => ({
  symbol: s.symbol,
  name: s.name,
  price: s.price,
  marketCap: s.marketCap,
  normalizedIndustry: getNormalizedIndustry(s.industry || s.sector || ''),
  ipoDate: s.ipoDate,
  daysPublic: s.daysPublic,
  isRecentIpo: true,
}));

// Extract unique values for filters
const grades = ['A', 'B', 'C', 'D', 'F'];
const industries = displayIndustries.map(i => i.name);
const priceRanges = [
  { label: 'Under $10', min: 0, max: 10 },
  { label: '$10 - $50', min: 10, max: 50 },
  { label: '$50 - $100', min: 50, max: 100 },
  { label: '$100 - $500', min: 100, max: 500 },
  { label: '$500+', min: 500, max: 999999 }
];
const marketCapRanges = [
  { label: 'Small Cap (<$2B)', min: 0, max: 2 },
  { label: 'Mid Cap ($2B-$10B)', min: 2, max: 10 },
  { label: 'Large Cap ($10B-$200B)', min: 10, max: 200 },
  { label: 'Mega Cap ($200B+)', min: 200, max: 999999 }
];
---

<Layout title="Stockbrowse | Browse Stocks Like Products">
  <section class="py-8 bg-[#080A0F] min-h-screen">
    <div class="max-w-7xl mx-auto px-4">
      <!-- Header: the site's home IS the browser — one-line value prop, then the grid -->
      <div class="mb-6">
        <h1 class="text-3xl font-bold mb-2">Find quality stocks. Understand why in seconds.</h1>
        <p class="text-[#CBD5E1]">
          Every US stock graded A–F on research-backed quality. Try the search: <span class="text-slate-300">"GLP-1"</span>, <span class="text-slate-300">"weed"</span>, or <span class="text-slate-300">"stocks like Amazon"</span>.
          <a href="/how-it-works" class="text-[#22D3EE] hover:underline ml-1">How it works →</a>
        </p>
      </div>

      <!-- Root-URL structured data (the FAQPage schema lives on /about with the marketing content) -->
      <script type="application/ld+json" is:inline>
      {
        "@context": "https://schema.org",
        "@type": "SoftwareApplication",
        "name": "Stockbrowse",
        "applicationCategory": "FinanceApplication",
        "operatingSystem": "Web",
        "description": "Browse stocks like products. Research-backed quality scores and letter grades for 4,000+ US companies.",
        "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" }
      }
      </script>

      <div>
        <!-- Search + Sort Bar -->
        <div class="bg-[#161B24] rounded-xl p-4 mb-4">
          <div class="flex flex-col md:flex-row gap-4 items-start md:items-center justify-between">
            <!-- Search -->
            <div class="flex-1 max-w-lg relative">
              <input
                type="text"
                id="searchInput"
                placeholder='Try "stocks like Amazon" or "cheap tech stocks"...'
                class="w-full px-4 py-2 bg-[#0C0F14] border border-[rgba(255,255,255,0.1)] text-slate-100 placeholder:text-[#64748B] rounded-lg focus:ring-2 focus:ring-[#22D3EE] focus:border-transparent"
              />
              <div id="searchSuggestions" class="hidden absolute top-full left-0 right-0 mt-1 bg-[#161B24] border border-[rgba(255,255,255,0.06)] rounded-lg shadow-lg z-10 max-h-64 overflow-y-auto">
              </div>
              <div id="searchLimitNotice" class="hidden mt-2 text-sm bg-[#161B24] border border-amber-500/40 text-amber-300 rounded-lg px-3 py-2">
                You've used your 5 free smart searches today — resets tomorrow.
                <a href="/pricing" class="text-[#22D3EE] hover:underline font-semibold">Upgrade for unlimited search →</a>
              </div>
            </div>

            <!-- Sort -->
            <div class="flex gap-3 items-center">
              <select id="sortSelect" class="px-4 py-2 bg-[#0C0F14] border border-[rgba(255,255,255,0.1)] text-slate-100 rounded-lg text-sm">
                <option value="relevance-desc">Best match</option>
                <option value="score-desc">Highest Score</option>
                <option value="score-asc">Lowest Score</option>
                <option value="price-asc">Price: Low to High</option>
                <option value="price-desc">Price: High to Low</option>
                <option value="marketcap-desc">Market Cap: Largest</option>
                <option value="marketcap-asc">Market Cap: Smallest</option>
                <option value="name-asc">Name: A-Z</option>
              </select>
              <a href="/watchlist" class="relative p-2 hover:bg-[#0C0F14] rounded-lg transition">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"></path>
                </svg>
                <span id="watchlistBadge" class="absolute -top-1 -right-1 bg-[#22D3EE] text-white text-xs rounded-full w-5 h-5 flex items-center justify-center hidden">0</span>
              </a>
            </div>
          </div>

          <!-- Smart Search Hint -->
          <div id="smartSearchHint" class="mt-3 text-sm text-[#22D3EE] bg-[#22D3EE]/10 border border-[#22D3EE]/30 rounded-lg px-3 py-2 hidden">
            <span class="font-semibold">Smart search active:</span> <span id="smartSearchText"></span>
          </div>
        </div>

        <!-- Filter Bar: Quick Chips + Dropdown Popovers -->
        <div class="bg-[#161B24] rounded-xl p-4 mb-4">
          <div class="flex flex-wrap items-center gap-2">
            <!-- Quick-toggle Grade Chips -->
            {grades.map(grade => {
              const colors = getGradeColor(grade);
              return (
                <button data-grade-chip={grade} class={`grade-chip px-3 py-1.5 rounded-full text-sm font-semibold border border-transparent transition cursor-pointer ${colors.bg} ${colors.text} opacity-60 hover:opacity-100`}>
                  Grade {grade}
                </button>
              );
            })}

            <div class="w-px h-6 bg-[rgba(255,255,255,0.1)]"></div>

            <!-- Quick toggles -->
            <button id="catalystFilter" class="quick-toggle px-3 py-1.5 rounded-full text-sm font-semibold bg-[#22D3EE]/15 text-[#22D3EE] opacity-60 hover:opacity-100 border border-transparent transition" title="Has a current catalyst — recent earnings beats + analyst upgrades">
              ⚡ Catalyst
            </button>
            <button id="goldenFilter" class="quick-toggle px-3 py-1.5 rounded-full text-sm font-semibold bg-amber-500/20 text-amber-400 opacity-60 hover:opacity-100 border border-transparent transition" title="Premium: top-decile quality + top-decile catalyst">
              ⭐ Golden
            </button>

            <div class="w-px h-6 bg-[rgba(255,255,255,0.1)]"></div>

            <!-- Dropdown Popover Buttons -->
            <div class="relative" id="industryDropdown">
              <button class="filter-dropdown-btn px-3 py-1.5 rounded-lg text-sm bg-[#080A0F] border border-[rgba(255,255,255,0.1)] text-[#CBD5E1] hover:border-[#22D3EE] transition flex items-center gap-1">
                Industry
                <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
              </button>
              <div class="filter-popover hidden absolute left-0 top-full mt-1 bg-[#161B24] border border-[rgba(255,255,255,0.06)] rounded-xl shadow-2xl p-4 z-20 w-64 max-h-72 overflow-y-auto">
                {industries.map(industry => (
                  <label class="flex items-center gap-2 cursor-pointer text-sm py-1.5 hover:text-[#22D3EE] transition">
                    <input type="checkbox" name="industry" value={industry} class="rounded text-[#22D3EE] filter-checkbox" />
                    <span>{industry}</span>
                  </label>
                ))}
              </div>
            </div>

            <div class="relative" id="priceDropdown">
              <button class="filter-dropdown-btn px-3 py-1.5 rounded-lg text-sm bg-[#080A0F] border border-[rgba(255,255,255,0.1)] text-[#CBD5E1] hover:border-[#22D3EE] transition flex items-center gap-1">
                Price
                <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
              </button>
              <div class="filter-popover hidden absolute left-0 top-full mt-1 bg-[#161B24] border border-[rgba(255,255,255,0.06)] rounded-xl shadow-2xl p-4 z-20 w-48">
                {priceRanges.map(range => (
                  <label class="flex items-center gap-2 cursor-pointer text-sm py-1.5 hover:text-[#22D3EE] transition">
                    <input type="checkbox" name="price" value={`${range.min}-${range.max}`} class="rounded text-[#22D3EE] filter-checkbox" />
                    <span>{range.label}</span>
                  </label>
                ))}
              </div>
            </div>

            <div class="relative" id="marketCapDropdown">
              <button class="filter-dropdown-btn px-3 py-1.5 rounded-lg text-sm bg-[#080A0F] border border-[rgba(255,255,255,0.1)] text-[#CBD5E1] hover:border-[#22D3EE] transition flex items-center gap-1">
                Market Cap
                <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
              </button>
              <div class="filter-popover hidden absolute left-0 top-full mt-1 bg-[#161B24] border border-[rgba(255,255,255,0.06)] rounded-xl shadow-2xl p-4 z-20 w-56">
                {marketCapRanges.map(range => (
                  <label class="flex items-center gap-2 cursor-pointer text-sm py-1.5 hover:text-[#22D3EE] transition">
                    <input type="checkbox" name="marketcap" value={`${range.min}-${range.max}`} class="rounded text-[#22D3EE] filter-checkbox" />
                    <span>{range.label}</span>
                  </label>
                ))}
              </div>
            </div>

            <div class="relative" id="valuationFilterSection">
              <button class="filter-dropdown-btn px-3 py-1.5 rounded-lg text-sm bg-[#080A0F] border border-[rgba(255,255,255,0.1)] text-[#CBD5E1] hover:border-[#22D3EE] transition flex items-center gap-1">
                Fair Value <span id="valuationPremiumBadge" class="text-[10px] bg-[#22D3EE]/20 text-[#22D3EE] px-1 rounded ml-1">Pro</span>
                <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
              </button>
              <div id="valuationFilters" class="filter-popover hidden absolute left-0 top-full mt-1 bg-[#161B24] border border-[rgba(255,255,255,0.06)] rounded-xl shadow-2xl p-4 z-20 w-48 opacity-50 pointer-events-none">
                <label class="flex items-center gap-2 cursor-pointer text-sm py-1.5">
                  <input type="checkbox" name="valuation" value="Undervalued" class="rounded text-[#22D3EE] filter-checkbox" />
                  <span class="text-emerald-400 font-semibold">Undervalued</span>
                </label>
                <label class="flex items-center gap-2 cursor-pointer text-sm py-1.5">
                  <input type="checkbox" name="valuation" value="Fair Value" class="rounded text-[#22D3EE] filter-checkbox" />
                  <span class="text-amber-400 font-semibold">Fair Value</span>
                </label>
                <label class="flex items-center gap-2 cursor-pointer text-sm py-1.5">
                  <input type="checkbox" name="valuation" value="Overvalued" class="rounded text-[#22D3EE] filter-checkbox" />
                  <span class="text-red-400 font-semibold">Overvalued</span>
                </label>
              </div>
            </div>

            <div class="w-px h-6 bg-[rgba(255,255,255,0.1)]"></div>
            <button id="clearFilters" class="text-sm text-[#64748B] hover:text-[#22D3EE] transition">Clear all</button>
          </div>

          <!-- Active Filters -->
          <div id="activeFilters" class="mt-3 flex flex-wrap gap-2 hidden"></div>

          <!-- Results Count -->
          <div class="mt-3 text-sm text-[#CBD5E1]">
            <span id="resultsCount">0</span> stocks found
          </div>
        </div>

          <!-- Stock Grid -->
          <div id="stockGrid" class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
            <!-- Populated by JavaScript -->
          </div>

          <!-- No Results -->
          <div id="noResults" class="hidden bg-[#161B24] rounded-xl p-12 text-center">
            <div class="text-5xl mb-4">🔍</div>
            <h3 class="text-xl font-bold mb-2">No stocks found</h3>
            <p class="text-[#CBD5E1] mb-4">Try adjusting your filters or search term</p>
            <button id="clearFiltersBtn" class="bg-[#22D3EE] hover:bg-[#06B6D4] text-white px-6 py-2 rounded-lg font-semibold transition">
              Clear All Filters
            </button>
          </div>
      </div>
    </div>
  </section>

  <script define:vars={{ allStocks, recentIpos }}>
    // State
    let filteredStocks = [...allStocks];
    let filters = {
      search: '',
      grades: [],
      industries: [],
      priceRanges: [],
      marketCapRanges: [],
      valuationRatings: [],
      goldenOnly: false,
      catalystOnly: false,
      sort: 'score-desc'
    };
    // Map<symbol, similarityScore> when a semantic ("meaning") search is active; null otherwise.
    let semanticRank = null;
    // Map<symbol, {why, kind}> populated only on a curated-catalog hit; empty otherwise.
    let semanticWhy = new Map();
    // Monotonic counter so an out-of-order semantic response is discarded.
    let searchSeq = 0;

    // Premium valuation data (fetched at runtime for Plus+ users)
    let valuationMap = {};  // symbol -> valuationRating
    let valuationDataLoaded = false;
    // Golden = Compass A/B + strong catalyst (PREMIUM, hydrated at runtime). Empty for free users.
    let goldenSet = new Set();
    // Catalyst is PREMIUM: the ⚡ chip shows for everyone but only FUNCTIONS for premium. catalystTagSet
    // (which stocks are tagged) is hydrated from the premium API; empty for free → filter yields nothing.
    // Access is tracked on window.__catalystAccess (set true by the premium module script below).
    let catalystTagSet = new Set();

    // URL State Management - persist filters in URL for back button support
    function saveFiltersToURL() {
      const params = new URLSearchParams();

      if (filters.search) params.set('q', filters.search);
      if (filters.grades.length) params.set('grades', filters.grades.join(','));
      if (filters.industries.length) params.set('industries', filters.industries.join(','));
      if (filters.priceRanges.length) params.set('price', filters.priceRanges.join(','));
      if (filters.marketCapRanges.length) params.set('cap', filters.marketCapRanges.join(','));
      if (filters.valuationRatings.length) params.set('valuation', filters.valuationRatings.join(','));
      if (filters.goldenOnly) params.set('golden', '1');
      if (filters.catalystOnly) params.set('catalyst', '1');
      if (filters.sort !== 'score-desc') params.set('sort', filters.sort);

      const newURL = params.toString() ? `${window.location.pathname}?${params}` : window.location.pathname;
      history.replaceState(null, '', newURL);
    }

    function restoreFiltersFromURL() {
      const params = new URLSearchParams(window.location.search);

      if (params.get('q')) {
        filters.search = params.get('q');
        document.getElementById('searchInput').value = filters.search;
      }
      if (params.get('grades')) {
        filters.grades = params.get('grades').split(',');
        filters.grades.forEach(g => {
          const chip = document.querySelector(`[data-grade-chip="${g}"]`);
          if (chip) {
            chip.classList.add('opacity-100', 'border-[#22D3EE]');
            chip.classList.remove('opacity-60');
          }
        });
      }
      if (params.get('industries')) {
        filters.industries = params.get('industries').split(',');
        filters.industries.forEach(i => {
          const cb = document.querySelector(`input[name="industry"][value="${i}"]`);
          if (cb) cb.checked = true;
        });
      }
      if (params.get('price')) {
        filters.priceRanges = params.get('price').split(',');
        filters.priceRanges.forEach(r => {
          const cb = document.querySelector(`input[name="price"][value="${r}"]`);
          if (cb) cb.checked = true;
        });
      }
      if (params.get('cap')) {
        filters.marketCapRanges = params.get('cap').split(',');
        filters.marketCapRanges.forEach(r => {
          const cb = document.querySelector(`input[name="marketcap"][value="${r}"]`);
          if (cb) cb.checked = true;
        });
      }
      if (params.get('valuation')) {
        filters.valuationRatings = params.get('valuation').split(',');
        filters.valuationRatings.forEach(v => {
          const cb = document.querySelector(`input[name="valuation"][value="${v}"]`);
          if (cb) cb.checked = true;
        });
      }
      if (params.get('golden') === '1') {
        filters.goldenOnly = true;
        const btn = document.getElementById('goldenFilter');
        if (btn) { btn.classList.add('opacity-100', 'border-amber-400'); btn.classList.remove('opacity-60'); }
      }
      if (params.get('catalyst') === '1') {
        filters.catalystOnly = true;
        const btn = document.getElementById('catalystFilter');
        if (btn) { btn.classList.add('opacity-100', 'border-[#22D3EE]'); btn.classList.remove('opacity-60'); }
      }
      if (params.get('sort')) {
        filters.sort = params.get('sort');
        document.getElementById('sortSelect').value = filters.sort;
      }
    }

    // Watchlist (stored in localStorage)
    function getWatchlist() {
      const stored = localStorage.getItem('compassWatchlist');
      return stored ? JSON.parse(stored) : [];
    }

    function saveWatchlist(watchlist) {
      localStorage.setItem('compassWatchlist', JSON.stringify(watchlist));
      updateWatchlistBadge();
    }

    function toggleWatchlist(symbol) {
      let watchlist = getWatchlist();
      if (watchlist.includes(symbol)) {
        watchlist = watchlist.filter(s => s !== symbol);
      } else {
        watchlist.push(symbol);
      }
      saveWatchlist(watchlist);
      renderStocks(); // Re-render to update heart icons
    }

    function updateWatchlistBadge() {
      const watchlist = getWatchlist();
      const badge = document.getElementById('watchlistBadge');
      if (watchlist.length > 0) {
        badge.textContent = watchlist.length;
        badge.classList.remove('hidden');
      } else {
        badge.classList.add('hidden');
      }
    }

    // Intelligent search parser
    function parseSmartSearch(query) {
      const q = query.toLowerCase().trim();
      const parsedFilters = {
        grades: [],
        industries: [],
        priceRanges: [],
        marketCapRanges: [],
        similarTo: null,
        keywords: []
      };

      // Pattern: "stocks like [company]" or "similar to [company]"
      const likePattern = /(?:stocks?\s+like|similar\s+to|like)\s+([a-z0-9\s]+?)(?:\s|$)/i;
      const likeMatch = q.match(likePattern);
      if (likeMatch) {
        const companyQuery = likeMatch[1].trim();
        // Shared brand/company alias map (defined above applyFilters).

        // Check alias first, then fall back to symbol/name match
        const aliasSymbol = BRAND_ALIASES[companyQuery.toLowerCase()];
        let referenceStock;
        if (aliasSymbol) {
          referenceStock = allStocks.find(s => s.symbol === aliasSymbol);
        }
        if (!referenceStock) {
          referenceStock = allStocks.find(s =>
            s.symbol.toLowerCase() === companyQuery.toLowerCase() ||
            s.name.toLowerCase().includes(companyQuery.toLowerCase())
          );
        }
        if (referenceStock) {
          parsedFilters.similarTo = referenceStock;
          // Auto-filter by same industry
          parsedFilters.industries.push(referenceStock.normalizedIndustry);

          // Also filter by similar market cap tier
          const mc = referenceStock.marketCap;
          if (mc >= 200) {
            parsedFilters.marketCapRanges.push('200-999999'); // Mega cap
          } else if (mc >= 10) {
            parsedFilters.marketCapRanges.push('10-200'); // Large cap
          } else if (mc >= 2) {
            parsedFilters.marketCapRanges.push('2-10'); // Mid cap
          } else {
            parsedFilters.marketCapRanges.push('0-2'); // Small cap
          }

          // Prefer high quality similar stocks
          if (referenceStock.grade === 'A' || referenceStock.grade === 'B') {
            parsedFilters.grades.push('A', 'B');
          }
        }
      }

      // Industry keywords
      const industryMap = {
        // Technology
        'tech': 'Technology', 'technology': 'Technology', 'software': 'Technology',
        'ai': 'Technology', 'artificial intelligence': 'Technology', 'cloud': 'Technology',
        'cybersecurity': 'Technology', 'semiconductor': 'Technology', 'chips': 'Technology',
        'saas': 'Technology', 'fintech': 'Technology',

        // Healthcare
        'healthcare': 'Healthcare', 'health': 'Healthcare', 'biotech': 'Healthcare', 'pharma': 'Healthcare',
        'medical': 'Healthcare', 'drug': 'Healthcare', 'hospital': 'Healthcare',

        // Finance
        'finance': 'Finance', 'financial': 'Finance', 'bank': 'Finance', 'banking': 'Finance',
        'insurance': 'Finance', 'mortgage': 'Finance', 'credit': 'Finance', 'investment': 'Finance',

        // Consumer
        'consumer': 'Consumer', 'retail': 'Consumer', 'restaurant': 'Consumer',
        'sports': 'Consumer', 'soccer': 'Consumer', 'racing': 'Consumer', 'entertainment': 'Consumer',
        'gaming': 'Consumer', 'casino': 'Consumer', 'hotels': 'Consumer', 'travel': 'Consumer',
        'automotive': 'Consumer', 'auto': 'Consumer', 'cars': 'Consumer', 'ev': 'Consumer',
        'electric vehicle': 'Consumer', 'food': 'Consumer', 'beverage': 'Consumer',
        'apparel': 'Consumer', 'fashion': 'Consumer', 'luxury': 'Consumer',

        // Energy
        'energy': 'Energy', 'oil': 'Energy', 'gas': 'Energy',
        'petroleum': 'Energy', 'solar': 'Energy', 'renewable': 'Energy', 'drilling': 'Energy',
        'natural gas': 'Energy', 'pipeline': 'Energy', 'refinery': 'Energy',

        // Industrials
        'industrial': 'Industrials', 'manufacturing': 'Industrials',
        'aerospace': 'Industrials', 'defense': 'Industrials', 'airlines': 'Industrials',
        'logistics': 'Industrials', 'shipping': 'Industrials', 'construction': 'Industrials',

        // Real Estate
        'real estate': 'Real Estate', 'realestate': 'Real Estate', 'reit': 'Real Estate',
        'property': 'Real Estate', 'housing': 'Real Estate',

        // Utilities
        'utilities': 'Utilities', 'utility': 'Utilities', 'electric': 'Utilities', 'water': 'Utilities',

        // Materials
        'materials': 'Materials', 'mining': 'Materials', 'steel': 'Materials', 'chemicals': 'Materials',
        'gold': 'Materials', 'copper': 'Materials',

        // Communication
        'communication': 'Communication Services', 'telecom': 'Communication Services', 'media': 'Communication Services',
        'streaming': 'Communication Services', 'social media': 'Communication Services', 'advertising': 'Communication Services'
      };
      for (const [keyword, industry] of Object.entries(industryMap)) {
        if (q.includes(keyword) && !parsedFilters.industries.includes(industry)) {
          parsedFilters.industries.push(industry);
        }
      }

      // Quality/Grade keywords
      if (q.match(/\b(best|top|high quality|highest rated|excellent|premium|grade a)\b/)) {
        parsedFilters.grades.push('A');
      }
      if (q.match(/\b(good|solid|quality|above average|grade b)\b/) && !parsedFilters.grades.includes('A')) {
        parsedFilters.grades.push('A', 'B');
      }
      if (q.match(/\b(safe|low risk|stable|conservative|defensive)\b/)) {
        parsedFilters.grades.push('A', 'B');
      }
      if (q.match(/\b(risky|speculative|high risk|volatile)\b/)) {
        parsedFilters.grades.push('D', 'F');
      }

      // Price keywords
      if (q.match(/\b(cheap|affordable|budget|inexpensive|penny)\b/)) {
        parsedFilters.priceRanges.push('0-10', '10-50');
      }
      if (q.match(/\bunder\s*\$?\s*(\d+)\b/)) {
        const priceMatch = q.match(/\bunder\s*\$?\s*(\d+)\b/);
        const price = parseInt(priceMatch[1]);
        if (price <= 10) parsedFilters.priceRanges.push('0-10');
        else if (price <= 50) parsedFilters.priceRanges.push('0-10', '10-50');
        else if (price <= 100) parsedFilters.priceRanges.push('0-10', '10-50', '50-100');
        else parsedFilters.priceRanges.push('0-10', '10-50', '50-100', '100-500');
      }
      if (q.match(/\bover\s*\$?\s*(\d+)\b/)) {
        const priceMatch = q.match(/\bover\s*\$?\s*(\d+)\b/);
        const price = parseInt(priceMatch[1]);
        if (price >= 500) parsedFilters.priceRanges.push('500-999999');
        else if (price >= 100) parsedFilters.priceRanges.push('100-500', '500-999999');
        else if (price >= 50) parsedFilters.priceRanges.push('50-100', '100-500', '500-999999');
      }

      // Market cap keywords
      if (q.match(/\b(large cap|mega cap|big companies|giants)\b/)) {
        parsedFilters.marketCapRanges.push('10-200', '200-999999');
      }
      if (q.match(/\b(small cap|microcap|micro cap|small companies)\b/)) {
        parsedFilters.marketCapRanges.push('0-2');
      }
      if (q.match(/\b(mid cap|medium sized|midsize)\b/)) {
        parsedFilters.marketCapRanges.push('2-10');
      }

      // Goal keywords
      if (q.match(/\b(dividend|income|yield)\b/)) {
        parsedFilters.industries.push('Utilities', 'Real Estate', 'Finance', 'Consumer');
        if (!parsedFilters.grades.includes('A')) {
          parsedFilters.grades.push('A', 'B');
        }
      }
      if (q.match(/\b(growth|growing|expansion)\b/)) {
        parsedFilters.industries.push('Technology', 'Healthcare', 'Communication Services');
        if (!parsedFilters.grades.includes('A')) {
          parsedFilters.grades.push('A', 'B');
        }
      }
      if (q.match(/\b(value|undervalued|bargain)\b/)) {
        parsedFilters.grades.push('B', 'C');
      }

      return parsedFilters;
    }

    function applySmartFilters(smartFilters) {
      // Apply parsed filters
      if (smartFilters.grades.length > 0) {
        filters.grades = [...new Set([...filters.grades, ...smartFilters.grades])];
      }
      if (smartFilters.industries.length > 0) {
        filters.industries = [...new Set([...filters.industries, ...smartFilters.industries])];
      }
      if (smartFilters.priceRanges.length > 0) {
        filters.priceRanges = [...new Set([...filters.priceRanges, ...smartFilters.priceRanges])];
      }
      if (smartFilters.marketCapRanges.length > 0) {
        filters.marketCapRanges = [...new Set([...filters.marketCapRanges, ...smartFilters.marketCapRanges])];
      }
    }

    // Semantic search: resolves to { rank: Map<symbol,score>, why: Map } or null.
    // Pure — no global writes, so a stale response can be discarded whole by the
    // caller's sequence guard (out-of-order responses used to clobber semanticWhy).
    // similarToStock (optional) triggers "stocks like X" using that company's own vector.
    // catalogOnly (optional) probes just the curated catalog: null on a miss
    // (grid stays literal) instead of falling back to the raw stock index.
    async function fetchSemanticResults(query, similarToStock, catalogOnly) {
      try {
        const payload = similarToStock ? { similarTo: similarToStock.symbol }
          : catalogOnly ? { query, catalogOnly: true }
          : { query };
        // window.__authFetch (set by the premium module script) sends the Bearer
        // so paid users are exempt from the free search quota; falls back to
        // plain fetch for anonymous visitors.
        const doFetch = window.__authFetch || fetch;
        const res = await doFetch('/api/search/semantic', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });
        const limitNotice = document.getElementById('searchLimitNotice');
        if (res.status === 429) {
          // Show the quota notice ONLY for the daily free-search limit —
          // the abuse rate-limiter also 429s (and paid users can hit it);
          // that one keeps the silent-degrade behavior.
          let isQuota = false;
          try { isQuota = (await res.json()).code === 'SEARCH_LIMIT'; } catch { /* not JSON */ }
          if (isQuota && limitNotice) limitNotice.classList.remove('hidden');
          return null;
        }
        if (limitNotice) limitNotice.classList.add('hidden');
        if (!res.ok) return null;
        const data = await res.json();
        if (!data.symbols || !data.symbols.length) return null;
        const rank = new Map();
        const why = new Map();
        for (const s of data.symbols) {
          rank.set(s.symbol, s.score);
          // Catalog hits carry a one-line "why"; raw-semantic results don't.
          if (s.why) why.set(s.symbol, { why: s.why, kind: s.kind });
        }
        return { rank, why };
      } catch {
        return null;
      }
    }

    // Filter functions
    // Brand/product/subsidiary -> parent ticker. Fixes the worst "nothing
    // relevant" class: typing "instagram"/"aws"/"gatorade" literal-matches no
    // company NAME, so users got junk substring hits or a vague semantic
    // basket. Every entry machine-validated against the live universe (ticker
    // exists; alias is not itself another company's ticker). Exact-query
    // aliases also rank their target FIRST over junk substring matches.
    const BRAND_ALIASES = {
  'google':'GOOGL','facebook':'META','coke':'KO','buffett':'BRK-B','mcdonalds':'MCD','raytheon':'RTX',
