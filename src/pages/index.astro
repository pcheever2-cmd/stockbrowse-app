  'excel':'MSFT','f-150':'F','facetime':'AAPL','falcon 9':'SPCX','fanta':'KO','febreze':'PG',
  'fitbit':'GOOGL','freestyle libre':'ABT','frito lay':'PEP','frontier airlines':'ULCC',
  'gardasil':'MRK','gatorade':'PEP','geforce':'NVDA','geico':'BRK-B','gemini ai':'GOOGL',
  'gillette':'PG','github':'MSFT','gmail':'GOOGL','gmc':'GM','green mountain coffee':'KDP',
  'haagen dazs':'GIS','hampton inn':'HLT','hbo':'WBD','head and shoulders':'PG',
  'homegoods':'TJX','hotels.com':'EXPE','hulu':'DIS','humira':'ABBV','icloud':'AAPL',
  'ihop':'DIN','imdb':'AMZN','instagram':'META','invisalign':'ALGN','ipad':'AAPL',
  'iphone':'AAPL','jell-o':'KHC','jira':'TEAM','jolly rancher':'HSY','kayak':'BKNG',
  'keytruda':'MRK','kfc':'YUM','kindle':'AMZN','kitkat':'HSY','kool-aid':'KHC','lays':'PEP',
  'lexus':'TM','lincoln cars':'F','linkedin':'MSFT','listerine':'KVUE',
  'longhorn steakhouse':'DRI','lucky charms':'GIS','lunchables':'KHC','macbook':'AAPL',
  'marlboro':'MO','marshalls':'TJX','marvel':'DIS','max streaming':'WBD','messenger':'META',
  'minecraft':'MSFT','minute maid':'KO','model 3':'TSLA','model y':'TSLA','modelo':'STZ',
  'mounjaro':'LLY','mountain dew':'PEP','mtv':'PSKY','mustang':'F','nbc':'CMCSA','nest':'GOOGL',
  'neutrogena':'KVUE','nickelodeon':'PSKY','oculus':'META','olay':'PG','old navy':'GAP',
  'old spice':'PG','olive garden':'DRI','opentable':'BKNG','oral-b':'PG','oreo':'MDLZ',
  'oscar mayer':'KHC','outlook':'MSFT','ozempic':'NVO','pampers':'PG','pandora music':'SIRI',
  'paramount plus':'PSKY','paxlovid':'PFE','peacock':'CMCSA','photoshop':'ADBE',
  'pillsbury':'GIS','pixar':'DIS','pixel phone':'GOOGL','pizza hut':'YUM','popeyes':'QSR',
  'powerade':'KO','powerwall':'TSLA','priceline':'BKNG','prime video':'AMZN',
  'quest headset':'META','radeon':'AMD','reeses':'HSY',
  'ring doorbell':'AMZN','ritz carlton':'MAR','ritz crackers':'MDLZ','ryzen':'AMD',
  'sheraton':'MAR','similac':'ABT','skyrizi':'ABBV','slack':'CRM','smartwater':'KO',
  'snapdragon':'QCOM','snapple':'KDP','sour patch kids':'MDLZ','splunk':'CSCO','sprite':'KO',
  'square payments':'XYZ','star wars':'DIS','starlink':'SPCX','stelara':'JNJ',
  'supercharger':'TSLA','swiffer':'PG','tableau':'CRM','taco bell':'YUM','taobao':'BABA',
  'td ameritrade':'SCHW','teams':'MSFT','temu':'PDD','threads':'META','tide':'PG',
  'tim hortons':'QSR','tj maxx':'TJX','trello':'TEAM','trulicity':'LLY','tsmc':'TSM',
  'twitch':'AMZN','twizzlers':'HSY','tylenol':'KVUE','tylenol pm':'KVUE',
  'universal studios':'CMCSA','velveeta':'KHC','venmo':'PYPL','viagra':'PFE',
  'victoria secret':'VSCO','vision pro':'AAPL','vmware':'AVGO','vrbo':'EXPE',
  'waldorf astoria':'HLT','waymo':'GOOGL','waze':'GOOGL','webex':'CSCO','wegovy':'NVO',
  'westin':'MAR','whatsapp':'META','whole foods':'AMZN','windows':'MSFT','xbox':'MSFT',
  'xfinity':'CMCSA','youtube':'GOOGL','zappos':'AMZN','zepbound':'LLY',
  'zyrtec':'KVUE'
    };
    Object.setPrototypeOf(BRAND_ALIASES, null); // 'constructor' etc. must not resolve
    const SYMBOL_SET = new Set(allStocks.map(s => s.symbol.toLowerCase()));

    function applyFilters() {
      filteredStocks = allStocks.filter(stock => {
        // Search filter — semantic discovery when active, else literal/keyword
        if (filters.search) {
          const query = filters.search.toLowerCase();

          if (semanticRank) {
            // Discovery mode: keep only stocks the meaning-search surfaced
            // (plus any exact literal match, so a typed ticker still shows).
            const literal = stock.symbol.toLowerCase() === query ||
                            stock.name.toLowerCase().includes(query) ||
                            BRAND_ALIASES[query.trim()] === stock.symbol;
            if (!semanticRank.has(stock.symbol) && !literal) return false;
          } else {
            // Literal lookup / keyword mode
            const literalMatch = stock.symbol.toLowerCase().includes(query) ||
                                 stock.name.toLowerCase().includes(query) ||
                                 BRAND_ALIASES[query.trim()] === stock.symbol;
            if (!literalMatch && !query.match(/\b(stocks?|like|similar|best|top|cheap|under|over|tech|healthcare|finance|dividend|growth)\b/)) {
              return false;
            }
          }
        }

        // Grade filter
        if (filters.grades.length > 0 && !filters.grades.includes(stock.grade)) {
          return false;
        }

        // Industry filter
        if (filters.industries.length > 0 && !filters.industries.includes(stock.normalizedIndustry)) {
          return false;
        }

        // Price range filter
        if (filters.priceRanges.length > 0) {
          const inRange = filters.priceRanges.some(range => {
            const [min, max] = range.split('-').map(Number);
            return stock.price >= min && stock.price <= max;
          });
          if (!inRange) return false;
        }

        // Market cap filter
        if (filters.marketCapRanges.length > 0) {
          const inRange = filters.marketCapRanges.some(range => {
            const [min, max] = range.split('-').map(Number);
            return stock.marketCap >= min && stock.marketCap <= max;
          });
          if (!inRange) return false;
        }

        // Golden filter (Compass A/B + strong catalyst). isGolden is a PREMIUM field,
        // hydrated at runtime into goldenSet for paid users; empty for free users.
        if (filters.goldenOnly && !goldenSet.has(stock.symbol)) {
          return false;
        }

        // Catalyst filter — PREMIUM: catalystTagSet is hydrated only for paid users (empty for free,
        // so this yields nothing even if toggled via URL — the chip upsells free users on click).
        if (filters.catalystOnly && !catalystTagSet.has(stock.symbol)) {
          return false;
        }

        // Valuation filter (premium — uses runtime data from KV)
        if (filters.valuationRatings.length > 0) {
          const rating = valuationMap[stock.symbol];
          if (!rating || !filters.valuationRatings.includes(rating)) {
            return false;
          }
        }

        return true;
      });

      // Apply sorting
      sortStocks();

      // Score-pending IPOs append to the END on a pure search match only (no
      // structural filters). They have no Compass score, so they stay out of the
      // ranked grid and sorts — this just makes a lookup like "SPCX"/"SpaceX" return
      // the real company instead of nothing.
      appendRecentIpoMatches();

      // Exact brand query ("instagram", "aws"): the aliased parent outranks
      // junk substring matches (e.g. "aws" used to surface Dawson Geophysical).
      const aq = (filters.search || '').toLowerCase().trim();
      // Exact-ticker queries always win over brand aliases ("coke" aliases KO,
      // but a user typing the literal ticker COKE means Coca-Cola Consolidated).
      const aliasTarget = aq && !SYMBOL_SET.has(aq) && BRAND_ALIASES[aq];
      if (aliasTarget) {
        const ai = filteredStocks.findIndex(s => s.symbol === aliasTarget);
        if (ai > 0) filteredStocks.unshift(filteredStocks.splice(ai, 1)[0]);
      }

      // An exactly-typed ticker always tops the list — over substring matches
      // in literal mode, over the theme basket in probe mode ("gold" pins
      // Barrick above the gold-miners picks). Mutually exclusive with the
      // brand pin: aliasTarget requires aq NOT be a ticker.
      if (aq && SYMBOL_SET.has(aq)) {
        const ti = filteredStocks.findIndex(s => s.symbol.toLowerCase() === aq);
        if (ti > 0) filteredStocks.unshift(filteredStocks.splice(ti, 1)[0]);
      }

      // Hand the active search context to the compare tool (sessionStorage,
      // same tab only): its peer chips then offer "more from your oil search"
      // in this result order instead of generic industry peers.
      try {
        if (filters.search && filteredStocks.length > 1) {
          sessionStorage.setItem('browseContext', JSON.stringify({
            query: filters.search,
            ts: Date.now(),
            symbols: filteredStocks.slice(0, 30).map(s => s.symbol),
          }));
        } else if (!filters.search) {
          // Abandoned search = abandoned context — compare must not keep
          // suggesting "more from your oil search" an hour later.
          sessionStorage.removeItem('browseContext');
        }
      } catch (e) { /* sessionStorage unavailable — compare falls back to industry peers */ }

      renderStocks();
      updateActiveFilters();
      saveFiltersToURL();
    }

    function appendRecentIpoMatches() {
      const q = (filters.search || '').trim().toLowerCase();
      if (!q) return;
      const hasStructuralFilters = filters.grades.length || filters.industries.length ||
        filters.priceRanges.length || filters.marketCapRanges.length ||
        filters.goldenOnly || filters.catalystOnly || filters.valuationRatings.length;
      if (hasStructuralFilters) return;
      const have = new Set(filteredStocks.map(s => s.symbol));
      const matches = recentIpos.filter(s =>
        !have.has(s.symbol) &&
        (s.symbol.toLowerCase().includes(q) || s.name.toLowerCase().includes(q) ||
         BRAND_ALIASES[q] === s.symbol)); // brand words can target score-pending IPOs too ("starlink" -> SPCX)
      filteredStocks = filteredStocks.concat(matches);
    }

    function sortStocks() {
      const [field, direction] = filters.sort.split('-');

      // Relevance = semantic similarity weighted by quality (the "best sellers" bias).
      // Compass 0-100 maps to a 0.5-1.0 multiplier, so quality nudges order without
      // overriding a much stronger semantic match.
      if (field === 'relevance') {
        if (semanticRank) {
          filteredStocks.sort((a, b) => {
            const sa = (semanticRank.get(a.symbol) || 0) * (0.5 + (a.compassScore || 0) / 200);
            const sb = (semanticRank.get(b.symbol) || 0) * (0.5 + (b.compassScore || 0) / 200);
            return sb - sa;
          });
        } else {
          // "Best match" with no active semantic ranking (e.g. sort restored
          // from a shared URL): fall back to score order instead of leaving
          // the grid unsorted via an unknown compare field.
          filteredStocks.sort((a, b) => (b.compassScore || 0) - (a.compassScore || 0));
        }
        return;
      }

      filteredStocks.sort((a, b) => {
        let aVal, bVal;

        if (field === 'score') {
          aVal = a.compassScore;
          bVal = b.compassScore;
        } else if (field === 'price') {
          aVal = a.price;
          bVal = b.price;
        } else if (field === 'marketcap') {
          aVal = a.marketCap;
          bVal = b.marketCap;
        } else if (field === 'name') {
          aVal = a.name.toLowerCase();
          bVal = b.name.toLowerCase();
        }

        if (direction === 'asc') {
          return aVal < bVal ? -1 : aVal > bVal ? 1 : 0;
        } else {
          return aVal > bVal ? -1 : aVal < bVal ? 1 : 0;
        }
      });
    }

    function renderStocks() {
      const grid = document.getElementById('stockGrid');
      const noResults = document.getElementById('noResults');
      const resultsCount = document.getElementById('resultsCount');
      const watchlist = getWatchlist();

      resultsCount.textContent = filteredStocks.length.toLocaleString();

      if (filteredStocks.length === 0) {
        grid.classList.add('hidden');
        noResults.classList.remove('hidden');
        return;
      }

      grid.classList.remove('hidden');
      noResults.classList.add('hidden');

      grid.innerHTML = filteredStocks.map(stock => {
