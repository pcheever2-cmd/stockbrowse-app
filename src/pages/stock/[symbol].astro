  <script>
    import { loadSession, hasFeature } from '../../lib/subscription';
    import { authFetch } from '../../lib/authFetch';

    document.addEventListener('DOMContentLoaded', async () => {
      // Load the user session (populates window.__compassUser)
      const user = await loadSession();

      // Check if user has premium access
      const isPremium = hasFeature('score_breakdown');

      if (isPremium) {
        // Remove blur and overlays for premium users
        document.querySelectorAll('.premium-section').forEach(section => {
          const content = section.querySelector('.premium-content');
          const overlay = section.querySelector('.premium-overlay');
          const badge = section.querySelector('.premium-badge');

          if (content) {
            content.classList.remove('blur-sm', 'pointer-events-none', 'select-none');
          }
          if (overlay) {
            overlay.remove();
          }
          if (badge) {
            badge.remove();
          }
        });

        // Hydrate premium fields from the API
        const symbol = window.location.pathname.split('/stock/')[1]?.replace(/\/$/, '').toUpperCase();
        if (symbol) {
          try {
            const res = await authFetch(`/api/stocks/premium?symbol=${symbol}`);
            if (res.ok) {
              const p = await res.json();
              if (p) {
                (window as any).__premiumData = p;
                hydratePremiumFields(p);
              }
            }
          } catch {
            // Silently fail — user sees the SSG version with N/A values
          }
        }

      function hydratePremiumFields(p: any) {
        const el = (key: string) => document.querySelector(`[data-premium="${key}"]`) as HTMLElement | null;
        const setVal = (key: string, text: string, colorClass?: string) => {
          const node = el(key);
          if (!node) return;
          node.textContent = text;
          if (colorClass) {
            node.classList.remove('text-slate-400', 'text-slate-100', 'text-slate-300', 'text-emerald-400', 'text-red-400', 'text-amber-400');
            node.classList.add(colorClass);
          }
        };

        // Golden flag (premium) — reveal the ⭐ Golden badge for top-decile quality + catalyst names.
        if (p.isGolden) {
          document.getElementById('golden-badge')?.classList.remove('hidden');
        }

        // Catalyst Signal (premium) — set ALL fields explicitly so none are left as 🔒
        // (the later cleanup would turn 🔒 into "N/A"); null coverage reads "No coverage".
        setVal('catalystScore',
               p.catalystScore != null ? String(p.catalystScore) : 'No coverage',
               p.catalystScore != null ? 'text-slate-100' : 'text-slate-400');
        setVal('beatStreak',
               p.beatStreak != null ? String(p.beatStreak) : '—',
               p.beatStreak != null && p.beatStreak >= 2 ? 'text-emerald-400' : 'text-slate-100');
        setVal('netUpgrades180d',
               p.netUpgrades180d != null
                 ? (p.netUpgrades180d > 0 ? `+${p.netUpgrades180d}` : String(p.netUpgrades180d))
                 : '—',
               p.netUpgrades180d == null ? 'text-slate-100'
                 : p.netUpgrades180d > 0 ? 'text-emerald-400'
                 : p.netUpgrades180d < 0 ? 'text-red-400' : 'text-slate-100');
        if (p.catalystTag) {
          const catBadge = document.querySelector('[data-premium="catalystLabel"]') as HTMLElement | null;
          if (catBadge) { catBadge.textContent = p.catalystLabel || 'Catalyst'; catBadge.classList.remove('hidden'); }
        }

        // Valuation Metrics
        if (p.evEbitda != null) setVal('evEbitda', p.evEbitda.toFixed(1));
        if (p.forwardPe != null) setVal('forwardPe', p.forwardPe.toFixed(1));
        if (p.sectorPe != null && p.forwardPe != null) {
          const color = p.forwardPe < p.sectorPe ? 'text-emerald-400' : p.forwardPe > p.sectorPe * 1.2 ? 'text-amber-400' : 'text-[#64748B]';
          setVal('sectorPe', `Sector: ${p.sectorPe.toFixed(1)}`, color);
        }
        if (p.pegRatio != null) setVal('pegRatio', p.pegRatio.toFixed(2));

        // Technical Overview
        if (p.rsi != null) {
          const rsiVal = p.rsi.toFixed(0);
          const rsiColor = p.rsi >= 70 ? 'text-red-400' : p.rsi <= 30 ? 'text-emerald-400' : 'text-slate-300';
          const rsiLabel = p.rsi >= 70 ? 'Overbought' : p.rsi <= 30 ? 'Oversold' : 'Neutral';
          setVal('rsi', rsiVal, rsiColor);
          setVal('rsiLabel', rsiLabel, rsiColor);
        }

        // SMA comparisons (current price vs moving averages)
        const smaPrice = parseFloat(el('sma50')?.dataset.price || '0');
        if (p.sma50 != null && smaPrice > 0) {
          const above = smaPrice > p.sma50;
          setVal('sma50', above ? 'Above' : 'Below', above ? 'text-emerald-400' : 'text-red-400');
        }
        if (p.sma200 != null && smaPrice > 0) {
          const above = smaPrice > p.sma200;
          setVal('sma200', above ? 'Above' : 'Below', above ? 'text-emerald-400' : 'text-red-400');
        }

        // Wall Street View
        if (p.avgPriceTarget != null) setVal('avgPriceTarget', `$${p.avgPriceTarget.toFixed(0)}`);
        if (p.upside != null) {
          const sign = p.upside > 0 ? '+' : '';
          setVal('upside', `${sign}${p.upside}%`, p.upside > 0 ? 'text-emerald-400' : 'text-red-400');
        }

        // Consensus (recalculate from detailed analyst ratings)
        if (p.recentRatings) {
          const ratings = p.recentRatings.split('\n').filter((l: string) => l.trim());
          if (ratings.length > 0) {
            let buyCount = 0, holdCount = 0, sellCount = 0;
            ratings.forEach((line: string) => {
              const r = line.toLowerCase();
              if (r.includes('buy') || r.includes('outperform') || r.includes('overweight')) buyCount++;
              else if (r.includes('sell') || r.includes('underperform') || r.includes('underweight')) sellCount++;
              else holdCount++;
            });
            const total = buyCount + holdCount + sellCount;
            const buyPct = buyCount / total;
            const sellPct = sellCount / total;

            let label: string, color: string, bgColor: string;
            if (buyPct >= 0.6) { label = 'Strong Buy'; color = 'text-emerald-400'; bgColor = 'bg-emerald-900/40'; }
            else if (buyPct >= 0.4) { label = 'Buy'; color = 'text-blue-400'; bgColor = 'bg-blue-900/40'; }
            else if (sellPct >= 0.6) { label = 'Strong Sell'; color = 'text-red-400'; bgColor = 'bg-red-900/40'; }
            else if (sellPct >= 0.4) { label = 'Sell'; color = 'text-amber-400'; bgColor = 'bg-amber-900/40'; }
            else { label = 'Hold'; color = 'text-slate-300'; bgColor = 'bg-slate-700/40'; }

            // Override if price target conflicts
            if (p.upside != null && p.upside < -15 && (label === 'Strong Buy' || label === 'Buy')) {
              label = 'Above Target'; color = 'text-amber-400'; bgColor = 'bg-amber-900/40';
            }
            if (p.upside != null && p.upside > 30 && (label === 'Strong Sell' || label === 'Sell')) {
              label = 'Below Target'; color = 'text-blue-400'; bgColor = 'bg-blue-900/40';
            }

            const consensusEl = el('consensus');
            const containerEl = el('consensusContainer');
            if (consensusEl) {
              consensusEl.textContent = label;
              consensusEl.classList.remove('text-emerald-400', 'text-blue-400', 'text-red-400', 'text-amber-400', 'text-slate-300', 'text-slate-400');
              consensusEl.classList.add(color);
            }
            if (containerEl) {
              containerEl.classList.remove('bg-emerald-900/40', 'bg-blue-900/40', 'bg-red-900/40', 'bg-amber-900/40', 'bg-slate-700/40', 'bg-slate-800/40');
              containerEl.classList.add(bgColor);
            }
          }
        }

        // Growth Projections
        if (p.epsGrowth != null) {
          const sign = p.epsGrowth > 0 ? '+' : '';
          setVal('epsGrowth', `${sign}${p.epsGrowth.toFixed(1)}%`, p.epsGrowth > 0 ? 'text-emerald-400' : 'text-red-400');
        }
        if (p.revenueGrowth != null) {
          const sign = p.revenueGrowth > 0 ? '+' : '';
          setVal('revenueGrowth', `${sign}${p.revenueGrowth.toFixed(1)}%`, p.revenueGrowth > 0 ? 'text-emerald-400' : 'text-red-400');
        }

        // Financial Health
        if (p.piotroskiScore != null) {
          const label = p.piotroskiScore >= 7 ? 'Strong' : p.piotroskiScore >= 4 ? 'Average' : 'Weak';
          const color = p.piotroskiScore >= 7 ? 'text-emerald-400' : p.piotroskiScore >= 4 ? 'text-slate-300' : 'text-red-400';
          setVal('piotroskiScore', `${p.piotroskiScore}/9`, color);
          setVal('piotroskiLabel', label, color);
        }
        if (p.altmanZ != null) {
          const label = p.altmanZ >= 2.99 ? 'Safe Zone' : p.altmanZ >= 1.81 ? 'Grey Zone' : 'Distress Zone';
          const color = p.altmanZ >= 2.99 ? 'text-emerald-400' : p.altmanZ >= 1.81 ? 'text-amber-400' : 'text-red-400';
          setVal('altmanZ', p.altmanZ.toFixed(2), color);
          setVal('altmanLabel', label, color);
        }

        // Factor Values (Score Breakdown detail panels)
        if (p.factorValues) {
          const factorUnits: Record<string, string> = {
            roa: '%', grossProfit: '%', operatingCashFlow: '%',
            freeCashFlow: '%', volatility: '%', assetGrowth: '%'
          };
          const factorAvgs: Record<string, number> = {
            roa: 2, grossProfit: 25, operatingCashFlow: 5,
            freeCashFlow: 3, volatility: 45, assetGrowth: 10
          };
          const invertedFactors = new Set(['volatility', 'assetGrowth']);

          // Rating thresholds (must match stocks.ts FACTOR_THRESHOLDS)
          const thresholds: Record<string, { strong: number; weak: number }> = {
            roa: { strong: 5, weak: -2 },
            grossProfit: { strong: 35, weak: 15 },
            operatingCashFlow: { strong: 10, weak: 0 },
            freeCashFlow: { strong: 8, weak: -2 },
            volatility: { strong: 35, weak: 60 },
            assetGrowth: { strong: 5, weak: 25 },
          };

          Object.entries(p.factorValues).forEach(([key, val]) => {
            if (val == null) return;
            const v = val as number;
            const avg = factorAvgs[key] || 0;
            const isGood = invertedFactors.has(key) ? v < avg : v > avg;
            const color = isGood ? 'text-emerald-400' : 'text-red-400';

            // Update detail panel value
            const displayEl = document.querySelector(`[data-factor-display="${key}"]`) as HTMLElement;
            if (displayEl) {
              displayEl.textContent = `${v.toFixed(1)}${factorUnits[key] || '%'}`;
              displayEl.classList.remove('text-emerald-400', 'text-red-400', 'text-slate-300', 'text-slate-500');
              displayEl.classList.add(color);
            }
            const btn = document.querySelector(`[data-factor="${key}"]`) as HTMLElement;
            if (btn) {
              btn.dataset.factorValue = `${v.toFixed(1)}${factorUnits[key] || '%'}`;
            }

            // Re-rate and update the badge (SSG fallback may be wrong)
            const t = thresholds[key];
            if (t) {
              let rating: string;
              if (invertedFactors.has(key)) {
                if (key === 'assetGrowth' && v < 0) rating = 'Weak';
                else if (v <= t.strong) rating = 'Strong';
                else if (v >= t.weak) rating = 'Weak';
                else rating = 'Average';
              } else {
                if (v >= t.strong) rating = 'Strong';
                else if (v <= t.weak) rating = 'Weak';
                else rating = 'Average';
              }

              const badgeEl = document.querySelector(`[data-factor-rating="${key}"]`) as HTMLElement;
              if (badgeEl) {
                badgeEl.textContent = rating;
                badgeEl.classList.remove('bg-emerald-900/40', 'text-emerald-400', 'bg-slate-700/40', 'text-slate-300', 'bg-red-900/40', 'text-red-400');
                if (rating === 'Strong') {
                  badgeEl.classList.add('bg-emerald-900/40', 'text-emerald-400');
                } else if (rating === 'Weak') {
                  badgeEl.classList.add('bg-red-900/40', 'text-red-400');
                } else {
                  badgeEl.classList.add('bg-slate-700/40', 'text-slate-300');
                }
              }
            }
          });
        }

        // Fair Value section (Pro only) — fundamental per-share fair value (descriptive, not a forecast)
        if (p.fairValue && p.fairValue.mid != null && hasFeature('fair_value')) {
          const fv = p.fairValue;
          const section = document.getElementById('fairvalue-section');
          if (section) {
            section.classList.remove('hidden');
            document.getElementById('fairvalue-teaser')?.remove();

            const rangeEl = document.getElementById('fv-range');
            if (rangeEl && fv.low != null && fv.high != null) {
              rangeEl.textContent = `$${fv.low.toFixed(0)}–$${fv.high.toFixed(0)}`;
            }
            const midEl = document.getElementById('fv-mid');
            if (midEl) midEl.textContent = `$${fv.mid.toFixed(2)}`;

            const upsideEl = document.getElementById('fv-upside');
            if (upsideEl && fv.upsidePct != null) {
              const up = fv.upsidePct;
              upsideEl.textContent = `${up > 0 ? '+' : ''}${up.toFixed(1)}%`;
              upsideEl.classList.remove('text-slate-400');
              upsideEl.classList.add(up >= 15 ? 'text-emerald-400' : up <= -15 ? 'text-red-400' : 'text-amber-400');
            }

            const verdictEl = document.getElementById('fv-verdict');
            if (verdictEl && fv.verdict) {
              verdictEl.textContent = fv.verdict;
              const c = fv.verdict === 'Undervalued' ? 'text-emerald-400'
                : fv.verdict === 'Fair Value' ? 'text-amber-400' : 'text-red-400';
              verdictEl.classList.remove('text-slate-400');
              verdictEl.classList.add(c);
            }

            const summaryEl = document.getElementById('fv-summary');
            if (summaryEl) {
              const basis = fv.basis === 'sector' ? 'sector peers' : 'industry peers';
              summaryEl.textContent =
                `Estimated from comparable ${basis} and the stock's own 5-year valuation history. `
                + (fv.verdict === 'Undervalued'
                    ? 'Trading below what its fundamentals justify vs peers and its own history.'
                    : fv.verdict === 'Overvalued'
                    ? 'Trading above what its fundamentals justify vs peers and its own history.'
                    : 'Trading roughly in line with what its fundamentals justify.')
                + ' Descriptive estimate — not a price target or forecast; cheap can be a value trap.';
            }
          }
        }

        // Analyst Track Record (Plus+)
        if (hasFeature('analyst_accuracy') &&
            (p.sectorAnalystAccuracy || (p.coveringAnalysts && p.coveringAnalysts.length > 0))) {
          const section = document.getElementById('analyst-track-record');
          if (section) {
            section.classList.remove('hidden');
            document.getElementById('track-record-teaser')?.remove();

            // Sector accuracy
            if (p.sectorAnalystAccuracy) {
              const box = document.getElementById('sector-accuracy-box');
              const label = document.getElementById('sector-accuracy-label');
              const value = document.getElementById('sector-accuracy-value');
              if (box && label && value) {
                box.classList.remove('hidden');
                // Use sector from the page (in the subtitle)
                const sectorText = document.querySelector('h1 + p')?.textContent?.split('•')[1]?.trim() || 'Sector';
                label.textContent = `${sectorText} Sector Accuracy`;
                value.textContent = `${p.sectorAnalystAccuracy}%`;
                const color = p.sectorAnalystAccuracy >= 55 ? 'text-emerald-400' : p.sectorAnalystAccuracy >= 50 ? 'text-amber-400' : 'text-red-400';
                value.classList.remove('text-slate-400');
                value.classList.add(color);
              }
            }

            // Covering analysts label
            const symbol = window.location.pathname.split('/stock/')[1]?.replace(/\/$/, '').toUpperCase();
            const coveringLabel = document.getElementById('analysts-covering-label');
            if (coveringLabel) coveringLabel.textContent = `Analysts Covering ${symbol}`;

            // Parse recent ratings for firm -> rating/date lookup
            const firmRatings: Record<string, { rating: string; date: string }> = {};
            if (p.recentRatings) {
              p.recentRatings.split('\n').filter((l: string) => l.trim()).forEach((line: string) => {
                const rest = line.slice(2).trim();
                const dateMatch = rest.match(/^(\d{4}-\d{2}-\d{2}):\s*/);
                if (dateMatch) {
                  const date = dateMatch[1];
                  const afterDate = rest.slice(dateMatch[0].length);
                  const [firm, rating] = afterDate.split('→').map((s: string) => s.trim());
                  if (firm && !firmRatings[firm]) {
                    firmRatings[firm] = { rating: rating || '', date };
                  }
                }
              });
            }

            // Build analyst rows
            if (p.coveringAnalysts && p.coveringAnalysts.length > 0) {
              const list = document.getElementById('analysts-list');
              if (list) {
                const currentPrice = parseFloat(document.querySelector('[data-premium="avgPriceTarget"]')?.closest('.grid')?.querySelector('.text-xl')?.textContent?.replace('$', '') || '0');

                // Sort by hit rate descending (default)
                const sorted = [...p.coveringAnalysts].sort((a: any, b: any) => b.hitRate - a.hitRate);

                list.innerHTML = sorted.map((analyst: any) => {
                  const fr = firmRatings[analyst.firm];
                  const rating = fr?.rating || '';
                  const ratingDate = fr?.date || '';

                  // Rating badge color
                  let ratingBg = 'bg-amber-500/20', ratingText = 'text-amber-400';
                  if (rating) {
                    const r = rating.toLowerCase();
                    if (r.includes('buy') || r.includes('outperform') || r.includes('overweight')) {
                      ratingBg = 'bg-emerald-500/20'; ratingText = 'text-emerald-400';
                    } else if (r.includes('sell') || r.includes('underperform') || r.includes('underweight')) {
                      ratingBg = 'bg-red-500/20'; ratingText = 'text-red-400';
                    }
                  }

                  const ratingBadge = rating ? `<span class="px-2 py-0.5 rounded text-xs font-medium ${ratingBg} ${ratingText}">${rating}</span>` : '';
                  const dateStr = ratingDate ? new Date(ratingDate).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) : '';
                  const dateEl = dateStr ? `<span class="text-[#64748B] text-xs">${dateStr}</span>` : '';

                  // Percentile color
                  const pctColor = analyst.percentile >= 75 ? 'text-emerald-400' : analyst.percentile >= 25 ? 'text-amber-400' : 'text-red-400';
                  const pctLabel = analyst.percentile >= 50 ? `Top ${100 - analyst.percentile}%` : `Bottom ${analyst.percentile}%`;

                  // Sector vs overall hit rate
                  const overallStr = analyst.overallHitRate != null ? `<span class="text-[#64748B] text-xs ml-1">(${analyst.overallHitRate}% overall)</span>` : '';

                  return `
                    <div class="analyst-row flex items-center justify-between bg-[#080A0F] rounded-lg px-4 py-3"
                         data-hitrate="${analyst.hitRate}" data-date="${ratingDate}" data-percentile="${analyst.percentile}">
                      <div class="flex flex-col sm:flex-row sm:items-center gap-1 sm:gap-3">
                        <span class="text-slate-200 font-medium">${analyst.firm}</span>
                        <div class="flex items-center gap-2">${ratingBadge}${dateEl}</div>
                      </div>
                      <div class="flex items-center gap-4">
                        <span class="${pctColor} font-bold">${analyst.hitRate}%</span>${overallStr}
                        <span class="text-[#64748B] text-sm whitespace-nowrap">${pctLabel}</span>
                      </div>
                    </div>`;
                }).join('');
              }
            }

            // Wire up sort buttons
            const sortAccBtn = document.getElementById('sort-accuracy');
            const sortDateBtn = document.getElementById('sort-date');
            const analystList = document.getElementById('analysts-list');

            function sortAnalystRows(by: 'accuracy' | 'date') {
              if (!analystList) return;
              const rows = Array.from(analystList.querySelectorAll('.analyst-row'));
              rows.sort((a, b) => {
                if (by === 'accuracy') {
                  return parseFloat(b.getAttribute('data-hitrate') || '0') - parseFloat(a.getAttribute('data-hitrate') || '0');
                } else {
                  const aDate = a.getAttribute('data-date') || '';
                  const bDate = b.getAttribute('data-date') || '';
                  if (aDate && !bDate) return -1;
                  if (!aDate && bDate) return 1;
                  return bDate.localeCompare(aDate);
                }
              });
              rows.forEach(row => analystList.appendChild(row));

              if (sortAccBtn && sortDateBtn) {
                if (by === 'accuracy') {
                  sortAccBtn.classList.add('bg-[#22D3EE]/20', 'text-[#22D3EE]');
                  sortAccBtn.classList.remove('text-[#64748B]');
                  sortDateBtn.classList.remove('bg-[#22D3EE]/20', 'text-[#22D3EE]');
                  sortDateBtn.classList.add('text-[#64748B]');
                } else {
                  sortDateBtn.classList.add('bg-[#22D3EE]/20', 'text-[#22D3EE]');
                  sortDateBtn.classList.remove('text-[#64748B]');
                  sortAccBtn.classList.remove('bg-[#22D3EE]/20', 'text-[#22D3EE]');
                  sortAccBtn.classList.add('text-[#64748B]');
                }
              }
            }

            sortAccBtn?.addEventListener('click', () => sortAnalystRows('accuracy'));
            sortDateBtn?.addEventListener('click', () => sortAnalystRows('date'));
          }
        }

        // Replace remaining locks with "N/A" — premium data was fetched,
        // so any lock still showing means the data genuinely doesn't exist
        document.querySelectorAll('[data-premium]').forEach(node => {
          const el = node as HTMLElement;
          if (el.textContent?.trim() === '🔒') {
            el.textContent = 'N/A';
            el.classList.remove('text-slate-100');
            el.classList.add('text-slate-500');
          }
        });
        document.querySelectorAll('[data-factor-display]').forEach(node => {
          const el = node as HTMLElement;
          if (el.textContent?.trim() === '🔒') {
            el.textContent = 'N/A';
            el.classList.add('text-slate-500');
          }
        });
      }
      }

      // Factor card clicks - toggle detail panel
      const factorCards = document.querySelectorAll('.factor-card');
      factorCards.forEach(card => {
        card.addEventListener('click', () => {
          const wrapper = card.closest('.factor-wrapper');
          const detail = wrapper?.querySelector('.factor-detail');
          if (detail) {
            // Close all other open details
            document.querySelectorAll('.factor-detail').forEach(d => {
              if (d !== detail) d.classList.add('hidden');
            });
            // Toggle this detail
            detail.classList.toggle('hidden');
          }
        });
      });

      // Metric card clicks - toggle detail panel (for Valuation, Technical, Financial Health)
      const metricCards = document.querySelectorAll('.metric-card');
      metricCards.forEach(card => {
        card.addEventListener('click', () => {
          const wrapper = card.closest('.metric-wrapper');
          const detail = wrapper?.querySelector('.metric-detail');
          if (detail) {
            // Close all other open metric details
            document.querySelectorAll('.metric-detail').forEach(d => {
              if (d !== detail) d.classList.add('hidden');
            });
            // Toggle this detail
            detail.classList.toggle('hidden');
          }
        });
      });

      // Handle unlock button clicks
      const unlockButtons = document.querySelectorAll('.unlock-btn');
      unlockButtons.forEach(btn => {
        btn.addEventListener('click', (e) => {
          e.stopPropagation();
          (window as any).showUpgradeModal();
        });
      });

      // Analyst sorting is now handled inside hydratePremiumFields()
    });
  </script>

  <!-- Price history chart (public, lightweight-charts) -->
  <script>
    import { authFetch } from '../../lib/authFetch';

    const ACCENT = '#22D3EE';
    const PE_COLOR = '#FBBF24';   // amber
    const EV_COLOR = '#A78BFA';   // violet
    const RANGE_MONTHS: Record<string, number> = { '1M': 1, '6M': 6, '1Y': 12, '5Y': 60, 'All': 0 };

    // Subtract whole months in UTC, clamping the day so month-end dates don't
    // roll forward (e.g. Mar 31 − 1mo → Feb 28, not Mar 3). Returns 'YYYY-MM-DD'.
    const monthsBefore = (isoDate: string, months: number): string => {
      const d = new Date(isoDate + 'T00:00:00Z');
      const day = d.getUTCDate();
      d.setUTCDate(1);
      d.setUTCMonth(d.getUTCMonth() - months);
      const daysInMonth = new Date(Date.UTC(d.getUTCFullYear(), d.getUTCMonth() + 1, 0)).getUTCDate();
      d.setUTCDate(Math.min(day, daysInMonth));
      return d.toISOString().slice(0, 10);
    };

    document.addEventListener('DOMContentLoaded', async () => {
      const section = document.getElementById('price-history');
      const container = document.getElementById('price-chart') as HTMLElement | null;
      if (!section || !container) return;

      const symbol = container.dataset.symbol;
      if (!symbol) return;

      // Code-split the ~30KB charting lib into its own async chunk (kept out of the main page bundle).
      const { createChart, AreaSeries, LineSeries, ColorType, LineStyle } = await import('lightweight-charts');

      let data: { time: string; value: number }[];
      try {
        // authFetch sends the token if signed in (Plus+ → full 5yr); anon/free get ~1yr.
        const res = await authFetch(`/api/stock/${symbol}/prices`);
        if (!res.ok) return;
        data = await res.json();
      } catch {
        return; // section stays hidden — degrade gracefully
      }
      if (!Array.isArray(data) || data.length < 2) return; // thin/missing history

      // Stored adjusted_close can be stale after a split, leaving one giant single-step
      // cliff (e.g. ~$2400 history then $254). Flag an extreme adjacent move (>60% in one
      // step) as a likely unadjusted split and surface a factual note — data is left as-is.
      let splitSuspected = false;
      for (let i = 1; i < data.length; i++) {
        const a = data[i - 1].value;
        const b = data[i].value;
        if (a > 0 && b > 0) {
          const r = b / a;
          if (r < 0.4 || r > 2.5) { splitSuspected = true; break; }
        }
      }
      if (splitSuspected) {
        document.getElementById('split-note')?.classList.remove('hidden');
      }

      // Reveal before creating the chart so autoSize measures a non-zero box.
      section.classList.remove('hidden');

      const chart = createChart(container, {
        autoSize: true,
        layout: {
          background: { type: ColorType.Solid, color: 'transparent' },
          textColor: '#94A3B8',
          attributionLogo: false,
        },
        grid: {
          vertLines: { visible: false },
          horzLines: { color: 'rgba(255,255,255,0.05)' },
        },
        rightPriceScale: { borderColor: 'rgba(255,255,255,0.08)' },
        timeScale: { borderColor: 'rgba(255,255,255,0.08)' },
        crosshair: {
          vertLine: { color: ACCENT, labelBackgroundColor: ACCENT },
          horzLine: { color: ACCENT, labelBackgroundColor: ACCENT },
        },
      });

      const series = chart.addSeries(AreaSeries, {
        lineColor: ACCENT,
        topColor: 'rgba(34,211,238,0.25)',
        bottomColor: 'rgba(34,211,238,0)',
        lineWidth: 2,
        priceFormat: { type: 'price', precision: 2, minMove: 0.01 },
      });
      series.setData(data);
      chart.timeScale().fitContent();

      // Range selector
      const first = data[0].time;
      const last = data[data.length - 1].time;
      const buttons = Array.from(
        document.querySelectorAll<HTMLButtonElement>('#price-range-buttons [data-range]')
      );
      const setActive = (active: HTMLButtonElement) => {
        buttons.forEach(b => {
          b.classList.toggle('text-[#22D3EE]', b === active);
          b.classList.toggle('bg-[#0F1419]', b === active);
          b.classList.toggle('text-[#64748B]', b !== active);
        });
      };
      buttons.forEach(btn => {
        btn.addEventListener('click', () => {
          const months = RANGE_MONTHS[btn.dataset.range || 'All'];
          if (!months) {
            chart.timeScale().fitContent();
          } else {
            const from = monthsBefore(last, months);
            chart.timeScale().setVisibleRange({ from: from < first ? first : from, to: last });
          }
          setActive(btn);
        });
      });
      const allBtn = buttons.find(b => b.dataset.range === 'All');
      if (allBtn) setActive(allBtn);

      // ---- Valuation overlays (trailing P/E, EV/EBITDA) on a shared left axis ----
      const legend = document.getElementById('chart-legend');
      const fmtPrice = (v: number) => '$' + v.toFixed(2);
      const fmtMult = (v: number) => v.toFixed(1) + '×';
      const chip = (color: string, label: string, val: string) =>
        `<span style="color:${color}">●</span> <span class="text-[#64748B]">${label}</span> <span class="text-slate-200 font-semibold">${val}</span>`;

      let peSeries: any = null;
      let evSeries: any = null;
      let overlays: { pe: any[]; evEbitda: any[]; fwdPe: number | null } = { pe: [], evEbitda: [], fwdPe: null };
      try {
        // Overlays are Plus-gated; authFetch sends the token if signed in, else the
        // request 401s and we fall back to a price-only chart (toggles stay hidden).
        const r = await authFetch(`/api/stock/${symbol}/overlays`);
        if (r.ok) overlays = await r.json();
      } catch { /* no overlays — price-only chart */ }

      const hasPe = Array.isArray(overlays.pe) && overlays.pe.length >= 2;
      const hasEv = Array.isArray(overlays.evEbitda) && overlays.evEbitda.length >= 2;

      const renderLegend = (param?: any) => {
        if (!legend) return;
        const valAt = (s: any, latest: any[]): number | null | undefined => {
          if (!s) return null;
          if (param && param.time) {
            const d = param.seriesData && param.seriesData.get(s);
            return d ? (d as any).value : undefined; // undefined = gap at this date
          }
          return latest.length ? latest[latest.length - 1].value : null;
        };
        const parts: string[] = [];
        const pv = valAt(series, data);
        if (pv != null) parts.push(chip(ACCENT, 'Price', fmtPrice(pv as number)));
        else if (pv === undefined) parts.push(chip(ACCENT, 'Price', '—'));
        if (peSeries && peSeries.options().visible) {
          const v = valAt(peSeries, overlays.pe);
          parts.push(chip(PE_COLOR, 'P/E', v == null ? (v === undefined ? '—' : '') : fmtMult(v as number)));
        }
        if (evSeries && evSeries.options().visible) {
          const v = valAt(evSeries, overlays.evEbitda);
          parts.push(chip(EV_COLOR, 'EV/EBITDA', v == null ? (v === undefined ? '—' : '') : fmtMult(v as number)));
        }
        const dateStr = param && param.time ? ` <span class="text-[#64748B]">${param.time}</span>` : '';
        legend.innerHTML = parts.join('&nbsp;&nbsp;&nbsp;') + dateStr;
      };

      if (hasPe || hasEv) {
        document.getElementById('overlay-toggles')?.classList.remove('hidden');
        chart.applyOptions({ leftPriceScale: { visible: false, borderColor: 'rgba(255,255,255,0.08)' } });

        const mkLine = (seriesData: any[], color: string) => {
          const s = chart.addSeries(LineSeries, {
            color, lineWidth: 2, priceScaleId: 'left',
            priceLineVisible: false, lastValueVisible: false, visible: false,
            priceFormat: { type: 'price', precision: 1, minMove: 0.1 },
          });
          s.setData(seriesData);
          return s;
        };

        const peBtn = document.querySelector<HTMLButtonElement>('#overlay-toggles [data-overlay="pe"]');
        const evBtn = document.querySelector<HTMLButtonElement>('#overlay-toggles [data-overlay="evEbitda"]');

        if (hasPe) {
          peSeries = mkLine(overlays.pe, PE_COLOR);
          if (overlays.fwdPe && overlays.fwdPe > 0) {
            peSeries.createPriceLine({
              price: overlays.fwdPe, color: PE_COLOR, lineWidth: 1,
              lineStyle: LineStyle.Dashed, axisLabelVisible: true, title: 'Fwd P/E',
            });
          }
        } else peBtn?.remove();
        if (hasEv) evSeries = mkLine(overlays.evEbitda, EV_COLOR);
        else evBtn?.remove();

        const syncLeftAxis = () => {
          const anyVisible = (peSeries && peSeries.options().visible) || (evSeries && evSeries.options().visible);
          chart.applyOptions({ leftPriceScale: { visible: !!anyVisible } });
        };
        const wireToggle = (btn: HTMLButtonElement | null, getS: () => any, color: string) => {
          if (!btn || !getS()) return;
          btn.addEventListener('click', () => {
            const s = getS();
            const vis = !s.options().visible;
            s.applyOptions({ visible: vis });
            btn.classList.toggle('text-slate-900', vis);
            btn.classList.toggle('text-[#64748B]', !vis);
            btn.style.backgroundColor = vis ? color : '';
            btn.style.borderColor = vis ? color : '';
            syncLeftAxis();
            renderLegend();
          });
        };
        wireToggle(peBtn, () => peSeries, PE_COLOR);
        wireToggle(evBtn, () => evSeries, EV_COLOR);

        // Deep-link: /stock/X?overlay=pe,evEbitda pre-activates overlays (shareable view).
        const want = new URLSearchParams(location.search).get('overlay');
        if (want) {
          want.split(',').forEach(k => {
            document.querySelector<HTMLButtonElement>(`#overlay-toggles [data-overlay="${k.trim()}"]`)?.click();
          });
        }
      }

      // ---- Auto valuation narrative (deterministic — recomputed from the data, never stale) ----
      const analysisEl = document.getElementById('chart-analysis');
      const buildNarrative = () => {
        if (!analysisEl || data.length < 2) return;
        const lastDate = data[data.length - 1].time;
        const winStart = monthsBefore(lastDate, 12);
        const haveYear = data[0].time <= monthsBefore(lastDate, 9);
        const asOf = (arr: any[]) => {
          let r = arr[0];
          for (const p of arr) { if (p.time <= winStart) r = p; else break; }
          return r;
        };
        const pct = (x: number) => (x >= 0 ? '+' : '') + Math.round(x * 100) + '%';
        const mult = (x: number) => x.toFixed(1) + '×';
        const strong = (c: string) => `<span class="font-semibold text-slate-100">${c}</span>`;
        const band = (q: number) => q >= 0.75 ? 'the upper end' : q <= 0.25 ? 'the lower end' : 'the middle';
        const pctile = (arr: any[], v: number) => arr.filter(p => p.value < v).length / arr.length;

        const peOk = Array.isArray(overlays.pe) && overlays.pe.length >= 30;
        const evOk = Array.isArray(overlays.evEbitda) && overlays.evEbitda.length >= 30;
        const primArr = peOk ? overlays.pe : (evOk ? overlays.evEbitda : null);
        const primName = peOk ? 'P/E' : 'EV/EBITDA';

        if (!primArr) {
          analysisEl.innerHTML = `<p class="text-[#64748B]">${symbol} hasn't had steady positive earnings over this window, so P/E and EV/EBITDA aren't meaningful here.</p>`;
          analysisEl.classList.remove('hidden');
          return;
        }

        const priceNow = data[data.length - 1].value;
        const priceThen = (asOf(data) || data[0]).value;
        const P = priceThen ? priceNow / priceThen - 1 : 0;
        const mNow = primArr[primArr.length - 1].value;
        const mThen = (asOf(primArr) || primArr[0]).value;
        const M = mThen ? mNow / mThen - 1 : 0;
        const window = haveYear ? 'over the past year' : 'over its available history';

        const sentences: string[] = [];

        // 1) Move decomposition: price change vs multiple change.
        let head: string;
        if (P > 0.03) {
          if (M <= P * 0.33)
            head = `${symbol} is ${strong(pct(P))} ${window}, but its ${primName} only moved ${strong(pct(M))} — most of that is earnings growing into the price rather than a richer multiple, the more durable kind of move.`;
          else if (M >= P * 0.75)
            head = `${symbol} is ${strong(pct(P))} ${window}, and its ${primName} expanded ${strong(pct(M))} right alongside it — much of the move is the market paying up per dollar of earnings, so it leans on expectations holding.`;
          else
            head = `${symbol} is ${strong(pct(P))} ${window}, split between earnings growth and a higher multiple (${primName} ${strong(pct(M))}).`;
        } else if (P < -0.03) {
          if (M > 0.03)
            head = `${symbol} is ${strong(pct(P))} ${window}, yet its ${primName} rose ${strong(pct(M))} — earnings fell faster than the price, so it screens more expensive than before.`;
          else
            head = `${symbol} is ${strong(pct(P))} ${window} and its ${primName} compressed with it (${strong(pct(M))}) — cheaper on earnings than before.`;
        } else {
          if (M > 0.05) head = `${symbol}'s price is roughly flat ${window} but its ${primName} rose ${strong(pct(M))}, a sign earnings softened underneath it.`;
          else if (M < -0.05) head = `${symbol}'s price is roughly flat ${window} while its ${primName} fell ${strong(pct(M))}, so earnings grew underneath it.`;
          else head = `${symbol} saw little change in price or valuation ${window}.`;
        }
        sentences.push(head);

        // 2) Where it sits in its own multi-year range.
        let s2 = `At ${strong(mult(mNow))} ${primName.toLowerCase() === 'p/e' ? 'earnings' : 'EBITDA'} it's in ${strong(band(pctile(primArr, mNow)))} of its 5-year range`;
        if (peOk && evOk) s2 += `, with EV/EBITDA at ${mult(overlays.evEbitda[overlays.evEbitda.length - 1].value)}`;
        sentences.push(s2 + '.');

        // 3) What the forward multiple implies.
        const fwd = overlays.fwdPe;
        if (peOk && fwd && fwd > 0) {
          const rel = fwd < mNow * 0.95 ? `below the trailing ${mult(mNow)}, so the market's pricing in earnings growth ahead`
            : fwd > mNow * 1.05 ? `above the trailing ${mult(mNow)}, implying the market expects earnings to soften`
            : `roughly in line with the trailing ${mult(mNow)}`;
          sentences.push(`Forward P/E is ${strong(mult(fwd))} — ${rel}.`);
        }

        analysisEl.innerHTML =
          `<div class="text-[11px] uppercase tracking-wide text-[#64748B] mb-1">What the valuation's saying <span class="normal-case text-[#475569]">· trailing-twelve-month, educational — not advice</span></div>` +
          sentences.map(s => `<p>${s}</p>`).join('');
        analysisEl.classList.remove('hidden');
      };
      buildNarrative();

      chart.subscribeCrosshairMove(renderLegend);
      renderLegend();
    });
  </script>

  <script>
    // Favorite (watchlist) toggle — reuses the free single-watchlist localStorage pattern
    // (`compassWatchlist`) shared by /browse/all, the nav badge, and the /watchlist page.
    document.addEventListener('DOMContentLoaded', () => {
      const btn = document.getElementById('favorite-btn');
      if (!btn) return;
      const symbol = btn.dataset.symbol;
      if (!symbol) return;

      const getWatchlist = (): string[] => {
        const stored = localStorage.getItem('compassWatchlist');
        return stored ? JSON.parse(stored) : [];
      };
      const saveWatchlist = (list: string[]) => {
        localStorage.setItem('compassWatchlist', JSON.stringify(list));
      };
      const toggleWatchlist = (sym: string): string[] => {
        let list = getWatchlist();
        list = list.includes(sym) ? list.filter(s => s !== sym) : [...list, sym];
        saveWatchlist(list);
        return list;
      };

      const icon = btn.querySelector('.fav-icon') as HTMLElement | null;
      const label = btn.querySelector('.fav-label') as HTMLElement | null;
      const setState = (active: boolean) => {
        if (icon) icon.innerHTML = active ? '&#9829;' : '&#9825;'; // filled ♥ / outline ♡
        if (label) label.textContent = active ? 'In watchlist' : 'Add to watchlist';
        btn.setAttribute('aria-label', active ? 'Remove from watchlist' : 'Add to watchlist');
        btn.classList.toggle('text-[#22D3EE]', active);
        btn.classList.toggle('bg-[#22D3EE15]', active);
      };

      setState(getWatchlist().includes(symbol));

      btn.addEventListener('click', () => {
        const list = toggleWatchlist(symbol);
        setState(list.includes(symbol));
        // Refresh the nav badge in-tab (Layout.astro's storage listener fires updateNavWatchlistBadge).
        window.dispatchEvent(new StorageEvent('storage', {
          key: 'compassWatchlist',
          newValue: localStorage.getItem('compassWatchlist'),
        }));
      });
    });
  </script>
</Layout>
