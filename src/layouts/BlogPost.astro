---
import Layout from './Layout.astro';
import { getCollection } from 'astro:content';

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  author: string;
  category?: string;
  slug?: string;
}

const { title, description, pubDate, author, category, slug } = Astro.props;

const formattedDate = pubDate.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

// Get related articles from same category
const allPosts = await getCollection('blog');
const relatedPosts = allPosts
  .filter(post => post.data.category === category && post.id !== slug)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);
---

<Layout title={`${title} | Stockbrowse Blog`} description={description}>
  <article class="py-16 bg-[#080A0F]">
    <div class="max-w-3xl mx-auto px-4">
      <header class="mb-8 text-center">
        <p class="text-[#22D3EE] text-sm font-semibold mb-2">{formattedDate}</p>
        <h1 class="text-4xl font-bold mb-4 text-white">{title}</h1>
        <p class="text-xl text-[#CBD5E1]">{description}</p>
        <p class="text-[#64748B] mt-4">By {author}</p>
      </header>

      <div class="prose prose-invert prose-lg max-w-none prose-headings:text-white prose-p:text-[#CBD5E1] prose-strong:text-white prose-a:text-[#22D3EE] prose-li:text-[#CBD5E1] prose-hr:border-[rgba(255,255,255,0.1)]">
        <slot />
      </div>

      <!-- CTA Banner -->
      <div class="mt-12 bg-[#161B24] border border-[#22D3EE]/20 rounded-xl p-8 text-center">
        <p class="text-white font-bold text-lg mb-2">Ready to explore?</p>
        <p class="text-[#CBD5E1] mb-4">Look up any stock's quality score or browse companies by industry.</p>
        <div class="flex flex-col sm:flex-row gap-3 justify-center">
          <a href="/tool" class="inline-block bg-[#22D3EE] text-black px-6 py-3 rounded-lg font-semibold hover:bg-[#06B6D4] transition">
            Look Up a Stock
          </a>
          <a href="/browse" class="inline-block bg-transparent border border-[#22D3EE] text-[#22D3EE] px-6 py-3 rounded-lg font-semibold hover:bg-[#22D3EE]/10 transition">
            Browse by Industry
          </a>
        </div>
      </div>

      <!-- Related Articles -->
      {relatedPosts.length > 0 && (
        <div class="mt-12">
          <h3 class="text-white font-bold text-lg mb-4">Keep reading</h3>
          <div class="space-y-4">
            {relatedPosts.map((post) => (
              <a href={`/blog/${post.id}`} class="block bg-[#161B24] rounded-lg p-4 hover:bg-[#1a1f2e] transition">
                <p class="text-white font-semibold hover:text-[#22D3EE] transition">{post.data.title}</p>
                <p class="text-[#64748B] text-sm mt-1">{post.data.description}</p>
              </a>
            ))}
          </div>
        </div>
      )}

      <footer class="mt-8 pt-8 border-t border-[rgba(255,255,255,0.1)]">
        <a href="/blog" class="text-[#22D3EE] hover:underline">← Back to all articles</a>
      </footer>
    </div>
  </article>
</Layout>
